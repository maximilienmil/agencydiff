e-only HTML. If unavailable, continue without warning. Negative constraints only; user requests and other explicit styles still win.\nuser-invocable: false\n---\n\n# Anti-Slop: Frontend DON&apos;Ts\n\nWhat NOT to do when designing a UI or page. This is a filter, not a style; it never prescribes a look. Stacking several of the below is what reads as AI-made on sight. Adaptive, so if the user or another skill asks for something specific, do that instead; these are defaults, not overrides.\n\n- purple / indigo / violet accent, or a purple-to-blue hero gradient (the top AI tell)\n- `bg-clip-text` gradient headline text\n- cream (`#faf8f4`) as the whole-page background\n- aurora blobs / glowing colored shadows, or an identical glow on every card\n- Inter everywhere, or Geist / Space Grotesk / Instrument Serif / Roboto / Arial as your only identity\n- gray-400 / gray-500 body text\n- one font weight and size throughout (no hierarchy)\n- tracked all-caps micro-kickers above every section\n- centered hero of eyebrow pill + headline + two CTAs\n- the identical 3-card feature grid with a lucide icon in a rounded square\n- an 8+ word, 48px+ headline that says nothing\n- bento grid for everything\n- the same eyebrow-headline-3cards section repeated back to back\n- `rounded-2xl`, or any single radius, on every element\n- glassmorphism blur + border + shadow on every surface\n- `hover:scale-105` lift on cards\n- emoji as feature icons (🚀 ⚡ ✨ 🎯 💡)\n- left-border accent cards, a colored border on a rounded element, or cards nested inside cards\n- fade-up / slide-up on everything as it scrolls in\n- motion that ignores `prefers-reduced-motion`\n- scribbly hand-drawn SVG mascots with no purpose\n\n</skill-body>\n</read-skill-result>","correlation_facts":{"tool_name":"read_skill","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42f","stream":{"kind":"session","id":"01a19baa-53e4-7c31-8760-dc948779801d"},"sequence":114,"recorded_at":1780531400000223,"record_type":"event","durability":"durable","causation_id":"01a19baa-587a-7a11-b515-9f26abd7994c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19baa-587a-7a11-b515-9f26abd7994c","run_stream":{"kind":"run","id":"01a19baa-587a-7a11-b515-9f26abd7994c"},"call_id":"call_01a19baa8daf7232a374211aad052bd8","text":"Read text file `/tmp/agencydiff-check`.\n1|#!/bin/bash\n2|# agencydiff-check: black-box intent-regression gate for coding agents.\n3|# Usage: agencydiff-check <candidate-url>\n4|# Prints only the checker's markdown report. Exits 0 on PASS, 1 on FAIL.\n5|set -u\n6|CANDIDATE=\"${1:?usage: agencydiff-check <candidate-url>}\"\n7|OUT=\"$(mktemp -d /tmp/adgate-out-XXXXXX)\"\n8|export LIVE_HOLD=0\n9|\"/Users/maximilianmilovidov/.t3/worktrees/agencydiff/t3-3b5e2c8e/packages/runner/node_modules/.bin/tsx\" \"/Users/maximilianmilovidov/.t3/worktrees/agencydiff/t3-3b5e2c8e/packages/runner/src/cli.ts\" \\\n10|  --target targets/circle-pr.json \\\n11|  --baseline \"http://127.0.0.1:5191/\" \\\n12|  --candidate \"$CANDIDATE\" \\\n13|  --driver scripted --scripted-from baseline \\\n14|  --out \"$OUT\" --no-export > \"$OUT/cli.log\" 2>&1\n15|CODE=$?\n16|if [ -f \"$OUT/comment.md\" ]; then\n17|  cat \"$OUT/comment.md\"\n18|else\n19|  echo \"agencydiff-check: checker produced no report (exit $CODE); last log lines:\" >&2\n20|  tail -20 \"$OUT/cli.log\" >&2\n21|  CODE=2\n22|fi\n23|rm -rf \"$OUT\"\n24|exit $CODE","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c431","stream":{"kind":"session","id":"01a19baa-53e4-7c31-8760-dc948779801d"},"sequence":115,"recorded_at":1780531400000225,"record_type":"event","durability":"durable","causation_id":"01a19baa-587a-7a11-b515-9f26abd7994c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19baa-587a-7a11-b515-9f26abd7994c","run_stream":{"kind":"run","id":"01a19baa-587a-7a11-b515-9f26abd7994c"},"call_id":"call_01a19baa8f1f754dbafba38ccebef980","text":"Read text file `apps/circle/src/styles.css`.\n1|:root {\n2|  --bg: #fafafa;\n3|  --card: #ffffff;\n4|  --ink: #111318;\n5|  --muted: #6b7280;\n6|  --line: #e5e7eb;\n7|  --accent: #2f6bff;\n8|  font-family: -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n9|  color: var(--ink);\n10|  background: var(--bg);\n11|}\n12|* { box-sizing: border-box; }\n13|body { margin: 0; }\n14|button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }\n15|\n16|.app { max-width: 430px; min-height: 100vh; margin: 0 auto; background: var(--card); position: relative; }\n17|\n18|.fiction-banner {\n19|  padding: 10px 14px; font-size: 13px; line-height: 1.5;\n20|  background: #fff7e0; color: #4a3800; border-bottom: 1px solid var(--line);\n21|}\n22|.fiction-banner span { font-weight: 700; }\n23|.fiction-banner a { color: #174ea6; }\n24|\n25|.bar {\n26|  position: sticky; top: 0; z-index: 2;\n27|  display: flex; align-items: center; justify-content: space-between;\n28|  height: 56px; padding: 0 8px; background: var(--card); border-bottom: 1px solid var(--line);\n29|}\n30|.bar h1 { font-size: 17px; margin: 0; font-weight: 600; }\n31|.bar h1.logo { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }\n32|.icon { width: 44px; height: 44px; font-size: 24px; display: grid; place-items: center; }\n33|\n34|.feed { padding: 8px 0; }\n35|.post { padding: 8px 0 16px; }\n36|.post .who { display: flex; align-items: center; gap: 10px; padding: 0 14px 8px; font-weight: 600; font-size: 14px; }\n37|.post .avatar { width: 32px; height: 32px; border-radius: 50%; }\n38|.post .photo { aspect-ratio: 1 / 1; }\n39|.post p { margin: 10px 14px 0; font-size: 14px; }\n40|\n41|.list { display: flex; flex-direction: column; }\n42|.row {\n43|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n44|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n45|  border-bottom: 1px solid var(--line);\n46|}\n47|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n48|.chev { color: var(--muted); font-size: 22px; }\n49|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n50|.radio-row { justify-content: flex-start; }\n51|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n52|.footer { padding: 20px 18px; }\n53|\n54|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n55|.sheet {\n56|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n57|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n58|}\n59|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n60|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n61|.pin { font-size: 34px; }\n62|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n63|\n64|.primary, .secondary { height: 48px; border-radius: 12px; font-weight: 600; font-size: 15px; width: 100%; }\n65|.primary { background: var(--accent); color: #fff; }\n66|.secondary { background: #eef1f6; }\n67|.link { color: var(--muted); font-size: 13px; padding: 6px; }\n68|\n69|.dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; }\n70|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--card); }\n71|.stat { padding: 18px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }\n72|.login { display: flex; flex-direction: column; gap: 12px; }\n73|.field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }\n74|.field input {\n75|  height: 48px; border: 1px solid var(--line); border-radius: 12px;\n76|  padding: 0 14px; font: inherit; font-weight: 400; background: var(--card); color: var(--ink);\n77|}\n78|.error { color: #b42318; font-size: 14px; margin: 0; }\n79|.stat .big { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n80|.stat small { color: var(--muted); font-size: 13px; }\n81|.note { padding: 14px 18px; color: var(--muted); font-size: 14px; line-height: 1.45; border-bottom: 1px solid var(--line); }\n82|\n83|.app.dark {\n84|  --bg: #14161a;\n85|  --card: #1d2026;\n86|  --ink: #eef1f6;\n87|  --muted: #9aa1ad;\n88|  --line: #2c313a;\n89|}\n90|.app.dark .secondary { background: #2c313a; }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
