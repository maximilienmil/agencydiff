s: center; gap: 10px; padding: 0 14px 8px; font-weight: 600; font-size: 14px; }\n37|.post .avatar { width: 32px; height: 32px; border-radius: 50%; }\n38|.post .photo { aspect-ratio: 1 / 1; }\n39|.post p { margin: 10px 14px 0; font-size: 14px; }\n40|\n41|.list { display: flex; flex-direction: column; }\n42|.row {\n43|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n44|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n45|  border-bottom: 1px solid var(--line);\n46|}\n47|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n48|.chev { color: var(--muted); font-size: 22px; }\n49|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n50|.radio-row { justify-content: flex-start; }\n51|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n52|.footer { padding: 20px 18px; }\n53|\n54|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n55|.sheet {\n56|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n57|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n58|}\n59|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n60|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
