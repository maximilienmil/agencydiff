: true },\n929|  { who: \"maya.r\", hue: 12 },\n930|  { who: \"dev_ko\", hue: 210 },\n931|  { who: \"lina\", hue: 280 },\n932|  { who: \"sam.j\", hue: 150 },\n933|  { who: \"noor\", hue: 330 },\n934|];\n935|\n936|function Avatar({ name, hue, size }: { name: string; hue: number; size: number }) {\n937|  return (\n938|    <span\n939|      className=\"avatar\"\n940|      style={{\n941|        width: size,\n942|        height: size,\n943|        fontSize: Math.round(size * 0.4),\n944|        background: `hsl(${hue} 62% 52%)`,\n945|      }}\n946|    >\n947|      {name.replace(/[^a-z]/gi, \"\").slice(0, 1).toUpperCase()}\n948|    </span>\n949|  );\n950|}\n951|\n952|function Feed({ posts }: { posts: typeof POSTS }) {\n953|  return (\n954|    <div className=\"feed\">\n955|      <div className=\"stories\" aria-label=\"Stories\">\n956|        {STORIES.map((st) => (\n957|          <span key={st.who} className={st.me ? \"story me\" : \"story\"}>\n958|            <span className=\"story-ring\">\n959|              <Avatar name={st.me ? \"You\" : st.who} hue={st.hue} size={56} />\n960|            </span>\n961|            <span className=\"story-name\">{st.who}</span>\n962|          </span>\n963|        ))}\n964|      </div>\n965|      {posts.map((p) => (\n966|        <article key={p.who} className=\"post\">\n967|          <div className=\"who\">\n968|            <Avatar name={p.name} hue={p.hue} size={36} />\n969|            <span className=\"who-text\">\n970|              <strong>{p.who}</strong>\n971|              <small>\n972|                {p.place} · {p.when}\n973|              </small>\n974|            </span>\n975|            <span className=\"more\" aria-hidden>\n976|              <Icon name=\"dots\" />\n977|            </span>\n978|          </div>\n979|          <div className=\"photo\" style={{ background: `hsl(${p.hue + 15} 70% 82%)` }}>\n980|            <span className=\"sun\" style={{ background: `hsl(${p.hue + 35} 90% 64%)` }} />\n981|            <span className=\"hill back\" style={{ background: `hsl(${p.hue - 10} 45% 62%)` }} />\n982|            <span className=\"hill\" style={{ background: `hsl(${p.hue - 25} 40% 44%)` }} />\n983|          </div>\n984|          <div className=\"post-actions\" aria-hidden>\n985|            <Icon name=\"heart\" />\n986|            <Icon name=\"comment\" />\n987|            <Icon name=\"share\" />\n988|            <span className=\"spacer\" />\n989|            <Icon name=\"bookmark\" />\n990|          </div>\n991|          <p className=\"likes\">{p.likes} likes</p>\n992|          <p>\n993|            <strong>{p.who}</strong> {p.text}\n994|          </p>\n995|        </article>\n996|      ))}\n997|    </div>\n998|  );\n999|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
