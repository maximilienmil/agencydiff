en === \"terms\" && (\n678|          <List>\n679|            <div className=\"note\">\n680|              Circle+ {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}. Your plan renews automatically each{\" \"}\n681|              {sub.plan === \"monthly\" ? \"month\" : \"year\"} until you cancel. Cancel anytime in Settings · Billing;\n682|              you keep Circle+ until the end of the paid period.\n683|            </div>\n684|          </List>\n685|        )}\n686|\n687|        {screen === \"billing\" && (\n688|          <List>\n689|            <div className=\"note\">\n690|              Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}\n691|            </div>\n692|            {false ? (\n693|              <Row label=\"Manage plan\" tag=\"sub.billing_manage\" onClick={() => push(\"plan_manage\")} />\n694|            ) : (\n695|              <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n696|            )}\n697|          </List>\n698|        )}\n699|\n700|        {screen === \"plan_manage\" && (\n701|          <List>\n702|            <Row label=\"Change plan\" />\n703|            <Row label=\"Pause plan\" />\n704|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n705|          </List>\n706|        )}\n707|\n708|        {screen === \"cancel_other\" && (\n709|          <List>\n710|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n711|          </List>\n712|        )}\n713|\n714|        {screen === \"appearance\" && (\n715|          <List>\n716|            <Option\n717|              title=\"Light\"\n718|              sub=\"Default bright theme\"\n719|              tag=\"appearance.light\"\n720|              selected={!dark}\n721|              onPick={() => setDark(false)}\n722|            />\n723|            <Option\n724|              title=\"Dark\"\n725|              sub=\"Dim the interface in the evening\"\n726|              tag=\"appe