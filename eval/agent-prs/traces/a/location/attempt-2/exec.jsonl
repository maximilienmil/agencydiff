         <button className=\"link\" data-agency=\"sub.decline\" onClick={declineOffer}>\n629|                      {copyTweak ? \"Maybe later\" : \"Not now\"}\n630|                    </button>\n631|                  ) : (\n632|                    <button className=\"link\" data-agency=\"sub.more\" onClick={() => push(\"decline_options\")}>\n633|                      More options\n634|                    </button>\n635|                  )}\n636|                </div>\n637|                <List>\n638|                  {!false ? (\n639|                    <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n640|                  ) : (\n641|                    <div className=\"note\">Full terms are shown after checkout.</div>\n642|                  )}\n643|                </List>\n644|              </>\n645|            ) : (\n646|              <List>\n647|                <Row label=\"Manage subscription\" tag=\"sub.manage\" onClick={() => push(\"billing\")} />\n648|                <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n649|              </List>\n650|            )}\n651|          </>\n652|        )}\n653|\n654|        {screen === \"decline_options\" && (\n655|          <>\n656|            <div className=\"note\">No problem. Circle stays free, and you can join Circle+ anytime.</div>\n657|            <div className=\"footer\">\n658|              <button\n659|                className=\"link\"\n660|                data-agency=\"sub.decline\"\n661|                onClick={() => {\n662|                  declineOffer();\n663|                  pop();\n664|                }}\n665|              >\n666|                Not now\n667|              </button>\n668|            </div>\n669|          </>\n670|        )}\n671|\n672|        {screen === \"terms\" && (\n673|          <List>\n674|            <div className=\"note\">\n675|              Circle+ {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}. Your plan renews automatically each{\" \"}\n676|              {sub.plan === \"monthly\" ? \"month\" : \"year\"} until you cancel. Cancel anytime in Settings · Billing;\n677|              you keep Circle+ until the end of the paid period.\n678|            </div>\n679|          </List>\n680|        )}\n681|\n682|        {screen === \"billing\" && (\n683|          <List>\n684|            <div className=\"note\">\n685|              Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}\n686|            </div>\n687|            {false ? (\n688|              <Row label=\"Manage plan\" tag=\"sub.billing_manage\" onClick={() => push(\"plan_manage\")} />\n689|            ) : (\n690|              <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n691|            )}\n692|          </List>\n693|        )}\n694|\n695|        {screen === \"plan_manage\" && (\n696|          <List>\n697|            <Row label=\"Change plan\" />\n698|            <Row label=\"Pause plan\" />\n699|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n700|          </List>\n701|        )}\n702|\n703|        {screen === \"cancel_other\" && (\n704|          <List>\n705|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n706|          </List>\n707|        )}\n708|\n709|        {screen === \"appearance\" && (\n710|          <List>\n711|            <Option\n712|              title=\"Light\"\n713|              sub=\"Default bright theme\"\n714|              tag=\"appearance.light\"\n715|              selected={!dark}\n716|              onPick={() => setDark(false)}\n717|            />\n718|            <Option\n719|              title=\"Dark\"\n720|              sub=\"Dim the interface in the evening\"\n721|              tag=\"appearance.dark\"\n722|              selected={dark}\n723|              onPick={() => setDark(true)}\n724|            />\n725|          </List>\n726|        )}\n727|      </main>