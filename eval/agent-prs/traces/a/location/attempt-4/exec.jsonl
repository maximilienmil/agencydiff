: center; gap: 10px; padding: 0 14px 8px; font-weight: 600; font-size: 14px; }\n37|.post .avatar { width: 32px; height: 32px; border-radius: 50%; }\n38|.post .photo { aspect-ratio: 1 / 1; }\n39|.post p { margin: 10px 14px 0; font-size: 14px; }\n40|\n41|.list { display: flex; flex-direction: column; }\n42|.row {\n43|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n44|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n45|  border-bottom: 1px solid var(--line);\n46|}\n47|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n48|.chev { color: var(--muted); font-size: 22px; }\n49|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n50|.radio-row { justify-content: flex-start; }\n51|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n52|.footer { padding: 20px 18px; }\n53|\n54|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n55|.sheet {\n56|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n57|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n58|}\n59|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n60|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n61|.pin { font-size: 34px; }\n62|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n63|\n64|.primary, .secondary { height: 48px; border-radius: 12px; font-weight: 600; font-size: 15px; width: 100%; }\n65|.primary { background: var(--accent); color: #fff; }\n66|.secondary { background: #eef1f6; }\n67|.link { color: var(--muted); font-size: 13px; padding: 6px; }\n68|\n69|.dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; }\n70|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--card); }\n71|.stat { padding: 18px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }\n72|.login { display: flex; flex-direction: column; gap: 12px; }\n73|.field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }\n74|.field input {\n75|  height: 48px; border: 1px solid var(--line); border-radius: 12px;\n76|  padding: 0 14px; font: inherit; font-weight: 400; background: var(--card); color: var(--ink);\n77|}\n78|.error { color: #b42318; font-size: 14px; margin: 0; }\n79|.stat .big { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n80|.stat small { color: var(--muted); font-size: 13px; }\n81|.note { padding: 14px 18px; color: var(--muted); font-size: 14px; line-height: 1.45; border-bottom: 1px solid var(--line); }\n82|\n83|.app.dark {\n84|  --bg: #14161a;\n85|  --card: #1d2026;\n86|  --ink: #eef1f6;\n87|  --muted: #9aa1ad;\n88|  --line: #2c313a;\n89|}\n90|.app.dark .secondary { background: #2c313a; }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
