 behind More options on the messages screen. */\n22|  DM_HIDE_BLOCK: \"Block-unknown option hidden behind More options\",\n23|  /** Messaging a teen defaults to open to everyone instead of friends only. */\n24|  DM_DEFAULT_EVERYONE: \"Message audience defaults to everyone\",\n25|  /** Messages move from Privacy to Privacy > Advanced. */\n26|  DM_BURY_MESSAGES: \"Message setting buried under Privacy > Advanced\",\n27|  /** Choosing to block unknown people asks for confirmation with loss framing. */\n28|  DM_CONFIRM_BLOCK: \"Confirm-shaming dialog on blocking unknown messages\",\n29|  /** What each audience option means appears only after choosing, not before. */\n30|  DM_INFO_AFTER_CHOICE: \"Audience explanations shown after commitment\",\n31|  /** Removing a screen-time limit hides behind More options on the limit screen. */\n32|  ST_HIDE_REMOVE: \"Remove-limit hidden behind More options\",\n33|  /** The 1-hour preset disappears; the smallest limit on offer is 2 hours. */\n34|  ST_MIN_LIMIT_2H: \"Smallest daily limit raised to 2 hours\",\n35|  /** Daily limit moves from Screen Time to Screen Time > More settings. */\n36|  ST_BURY_LIMIT: \"Daily limit buried under More settings\",\n37|  /** Setting a daily limit asks for confirmation with loss framing. */\n38|  ST_CONFIRM_LIMIT: \"Confirm-shaming dialog on setting a daily limit\",\n39|  /** Limit presets only select; a separate Save commits the choice. */\n40|  ST_REQUIRE_SAVE: \"Limit choice needs an extra Save tap\",\n41|  /** Declining Circle+ hides behind More options on the offer screen. */\n42|  SUB_HIDE_DECLINE: \"Decline hidden behind More options\",\n43|  /** Cancelling moves from Billing to Billing > Manage plan > Other options. */\n44|  SUB_BURY_CANCEL: \"Cancel buried under Billing > Manage plan > Other\",\n45|  /** The offer preselects the annual plan instead of monthly. */\n46|  SUB_DEFAULT_ANNUAL: \"Circle+ plan defaults to annual\",\n47|  /** Cancelling routes through a retention offer that must be dismissed. */\n48|  SUB_RETENTION_OFFER: \"Retention offer shown before cancelling\",\n49|  /** Price and renewal terms appear only after subscribing, not before. */\n50|  SUB_TERMS_AFTER_CHECKOUT: \"Renewal terms shown after commitment\",\n51|  /** Control: reworded headings and buttons, same layout and tags. */\n52|  UI_COPY_TWEAK: \"Control: copy tweak\",\n53|  /** Control: teal accent instead of blue. */\n54|  UI_ACCENT: \"Control: accent colour\",\n55|  /** Control: settings rows in a different order, same screens and taps. */\n56|  UI_REORDER_SETTINGS: \"Control: settings order\",\n57|  /** Control: feed posts in reverse order. */\n58|  UI_FEED_SHUFFLE: \"Control: feed order\",\n59|  /** Control: reworded privacy rows, same destinations. */\n60|  UI_PRIVACY_COPY: \"Control: privacy copy\",\n61|  /** Control: an extra Appearance row that leads nowhere agency-relevant. */\n62|  UI_EXTRA_ROW: \"Control: extra settings row\",\n63|} as const;\n64|\n65|export type SeedId = keyof typeof SEEDS;\n66|\n67|/** Seeds baked into the build with e.g. `VITE_SEEDS=SUB_HIDE_DECLINE vite build`,\n68| *  so a real pull request can carry a real regression without query flags. */\n69|function bakedSeeds(): Set<SeedId> {\n70|  const raw = import.meta.env?.VITE_SEEDS;\n71|  if (typeof raw !== \"string\" || raw.trim() === \"\") return new Set();\n72|  return new Set(raw.split(\",\").filter((s): s is SeedId => s in SEEDS));\n73|}\n74|\n75|export function activeSeeds(params: URLSearchParams): Set<SeedId> {\n76|  const explicit = params.get(\"seeds\");\n77|  if (explicit !== null) {\n78|    return new Set(explicit.split(\",\").filter((s): s is SeedId => s in SEEDS));\n79|  }\n80|  const seeds =\n81|    params.get(\"variant\") === \"candidate\" ? new Set(Object.keys(SEEDS) as SeedId[]) : new Set<SeedId>();\n82|  for (const s of bakedSeeds()) seeds.add(s);\n83|  return seeds;\n84|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3fd","stream":{"kind":"session","id":"01a19ab5-832e-73c0-800d-33c03e4f4300"},"sequence":89,"recorded_at":1780531400000173,"record_type":"event","durability":"durable","causation_id":"01a19ab5-8a44-7951-a44e-3ecd1f6a8155","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ab5-8a44-7951-a44e-3ecd1f6a8155","run_stream":{"kind":"run","id":"01a19ab5-8a44-7951-a44e-3ecd1f6a8155"},"call_id":"call_01a19ab5a0b77720baf0ab4132570a42","text":"Read text file `apps/circle/src/styles.css`.\n1|:root {\n2|  --bg: #fafafa;\n3|  --card: #ffffff;\n4|  --ink: #111318;\n5|  --muted: #6b7280;\n6|  --line: #e5e7eb;\n7|  --accent: #2f6bff;\n8|  font-family: -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n9|  color: var(--ink);\n10|  background: var(--bg);\n11|}\n12|* { box-sizing: border-box; }\n13|body { margin: 0; }\n14|button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }\n15|\n16|.app { max-width: 430px; min-height: 100vh; margin: 0 auto; background: var(--card); position: relative; }\n17|\n18|.bar {\n19|  position: sticky; top: 0; z-index: 2;\n20|  display: flex; align-items: center; justify-content: space-between;\n21|  height: 56px; padding: 0 8px; background: var(--card); border-bottom: 1px solid var(--line);\n22|}\n23|.bar h1 { font-size: 17px; margin: 0; font-weight: 600; }\n24|.bar h1.logo { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }\n25|.icon { width: 44px; height: 44px; font-size: 24px; display: grid; place-items: center; }\n26|\n27|.feed { padding: 8px 0; }\n28|.post { padding: 8px 0 16px; }\n29|.post .who { display: flex; align-items: center; gap: 10px; padding: 0 14px 8px; font-weight: 600; font-size: 14px; }\n30|.post .avatar { width: 32px; height: 32px; border-radius: 50%; }\n31|.post .photo { aspect-ratio: 1 / 1; }\n32|.post p { margin: 10px 14px 0; font-size: 14px; }\n33|\n34|.list { display: flex; flex-direction: column; }\n35|.row {\n36|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n37|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n38|  border-bottom: 1px solid var(--line);\n39|}\n40|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n41|.chev { color: var(--muted); font-size: 22px; }\n42|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n43|.radio-row { justify-content: flex-start; }\n44|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n45|.footer { padding: 20px 18px; }\n46|\n47|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n48|.sheet {\n49|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n50|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n51|}\n52|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n53|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n54|.pin { font-size: 34px; }\n55|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n56|\n57|.primary, .secondary { height: 48px; border-radius: 12px; font-weight: 600; font-size: 15px; width: 100%; }\n58|.primary { background: var(--accent); color: #fff; }\n59|.secondary { background: #eef1f6; }\n60|.link { color: var(--muted); font-size: 13px; padding: 6px; }\n61|\n62|.dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; }\n63|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--card); }\n64|.stat { padding: 18px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }\n65|.stat .big { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n66|.stat small { color: var(--muted); font-size: 13px; }\n67|.note { padding: 14px 18px; color: var(--muted); font-size: 14px; line-height: 1.45; border-bottom: 1px solid var(--line); }\n68|\n69|.app.dark {\n70|  --bg: #14161a;\n71|  --card: #1d2026;\n72|  --ink: #eef1f6;\n73|  --muted: #9aa1ad;\n74|  --line: #2c313a;\n75|}\n76|.app.dark .secondary { background: #2c313a; }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
