{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b7","stream":{"kind":"session","id":"01a19ab8-fe17-7081-829e-1170c6a57ef1"},"sequence":54,"recorded_at":1780531400000103,"record_type":"event","durability":"durable","causation_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","run_stream":{"kind":"run","id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92"},"call_id":"call_01a19ab908747036bceaa966af5ff37a","text":"Read text file `apps/circle/src/App.tsx`.\n1|import { useEffect, useMemo, useState } from \"react\";\n2|import type { CSSProperties } from \"react\";\n3|import { activeSeeds, type SeedId } from \"./seeds\";\n4|\n5|// Circle: a deliberately ordinary social app used as AgencyDiff's controlled\n6|// target. Controls that matter to a decision carry `data-agency` tags and the\n7|// root carries `data-screen`; the runner records these for measurement, but the\n8|// agent only ever sees screenshots.\n9|\n10|type Screen =\n11|  | \"home\" | \"settings\" | \"privacy\" | \"advanced\" | \"location\" | \"location_options\"\n12|  | \"messages\" | \"dm_options\"\n13|  | \"screentime\" | \"st_more\" | \"st_limit\" | \"st_remove\" | \"usage\"\n14|  | \"plus\" | \"decline_options\" | \"terms\" | \"billing\" | \"plan_manage\" | \"cancel_other\"\n15|  | \"appearance\";\n16|type Mode = \"precise\" | \"approximate\" | \"off\";\n17|type DmPolicy = \"everyone\" | \"friends\" | \"blocked\";\n18|type SubPlan = \"monthly\" | \"annual\";\n19|\n20|interface LocationState {\n21|  mode: Mode;\n22|  prompt: \"open\" | \"answered\";\n23|}\n24|\n25|interface DmState {\n26|  policy: DmPolicy;\n27|}\n28|\n29|interface StState {\n30|  limit: number | null;\n31|  reminders: boolean;\n32|}\n33|\n34|interface SubState {\n35|  active: boolean;\n36|  plan: SubPlan;\n37|  offer: \"open\" | \"answered\";\n38|}\n39|\n40|const TITLES: Record<Screen, string> = {\n41|  home: \"Circle\",\n42|  settings: \"Settings\",\n43|  privacy: \"Privacy\",\n44|  advanced: \"Advanced\",\n45|  location: \"Location\",\n46|  location_options: \"Location options\",\n47|  messages: \"Messages\",\n48|  dm_options: \"Message options\",\n49|  screentime: \"Screen Time\",\n50|  st_more: \"More settings\",\n51|  st_limit: \"Daily limit\",\n52|  st_remove: \"Remove limit\",\n53|  usage: \"Your time\",\n54|  plus: \"Circle+\",\n55|  decline_options: \"More options\",\n56|  terms: \"Renewal terms\",\n57|  billing: \"Billing\",\n58|  plan_manage: \"Manage plan\",\n59|  cancel_other: \"Other options\",\n60|  appearance: \"Appearance\",\n61|};\n62|\n63|function initialLocation(params: URLSearchParams, seeds: Set<SeedId>): LocationState {\n64|  if (params.get(\"fixture\") === \"location-shared\") return { mode: \"precise\", prompt: \"answered\" };\n65|  // Any other fixture means the probe starts past onboarding: the location\n66|  // prompt is answered and out of the way of the decision under test.\n67|  if (params.get(\"fixture\")) return { mode: \"off\", prompt: \"answered\" };\n68|  return { mode: seeds.has(\"LOC_DEFAULT_ON\") ? \"precise\" : \"off\", prompt: \"open\" };\n69|}\n70|\n71|function initialDm(params: URLSearchParams, seeds: Set<SeedId>): DmState {\n72|  if (params.get(\"fixture\") === \"dm-restricted\") return { policy: \"blocked\" };\n73|  return { policy: seeds.has(\"DM_DEFAULT_EVERYONE\") ? \"everyone\" : \"friends\" };\n74|}\n75|\n76|function initialSt(params: URLSearchParams): StState {\n77|  if (params.get(\"fixture\") === \"limit-set\") return { limit: 480, reminders: false };\n78|  return { limit: null, reminders: false };\n79|}\n80|\n81|function initialSub(params: URLSearchParams, seeds: Set<SeedId>): SubState {\n82|  const fixture = params.get(\"fixture\");\n83|  if (fixture === \"subscribed\") return { active: true, plan: \"monthly\", offer: \"answered\" };\n84|  if (fixture === \"cancelled\") return { active: false, plan: \"monthly\", offer: \"answered\" };\n85|  return { active: false, plan: seeds.has(\"SUB_DEFAULT_ANNUAL\") ? \"annual\" : \"monthly\", offer: \"open\" };\n86|}\n87|\n88|declare global {\n89|  interface Window {\n90|    __circle?: { state: () => Record<string, unknown>; seeds: string[] };\n91|  }\n92|}\n93|\n94|const DM_INFO: Record<DmPolicy, string> = {\n95|  everyone: \"Anyone on Circle will be able to send messages to this account, including people you don't know.\",\n96|  friends: \"Only people you follow back will be able to message this account.\",\n97|  blocked: \"People you don't know will be blocked from messaging this account.\",\n98|};\n99|\n100|function limitLabel(limit: number | null): string {\n101|  if (limit === null) return \"Off\";\n102|  const h = limit / 60;\n103|  return `${h} hour${h === 1 ? \"\" : \"s\"} a day`;\n104|}\n105|\n106|const PLAN_NAME: Record<SubPlan, string> = { monthly: \"Monthly\", annual: \"Annual\" };\n107|const PLAN_PRICE: Record<SubPlan, string> = { monthly: \"$4.99/mo\", annual: \"$47.99/yr\" };\n108|\n109|export function App() {\n110|  const params = useMemo(() => new URLSearchParams(location.search), []);\n111|  const seeds = useMemo(() => activeSeeds(params), [params]);\n112|  const has = (s: SeedId) => seeds.has(s);\n113|\n114|  const [loc, setLoc] = useState<LocationState>(() => initialLocation(params, seeds));\n115|  const [dm, setDm] = useState<DmState>(() => initialDm(params, seeds));\n116|  const [st, setSt] = useState<StState>(() => initialSt(params));\n117|  const [sub, setSub] = useState<SubState>(() => initialSub(params, seeds));\n118|  const [stack, setStack] = useState<Screen[]>([\"home\"]);\n119|  const [seen, setSeen] = useState<string[]>([]);\n120|  const [confirm, setConfirm] = useState<null | (() => void)>(null);\n121|  const [dmConfirm, setDmConfirm] = useState<null | (() => void)>(null);\n122|  const [dmPending, setDmPending] = useState<DmPolicy | null>(null);\n123|  const [stPending, setStPending] = useState<{ value: number | null } | null>(null);\n124|  const [stConfirm, setStConfirm] = useState<null | (() => void)>(null);\n125|  const [subRetain, setSubRetain] = useState(false);\n126|  const [dark, setDark] = useState(false);\n127|  const screen = stack[stack.length - 1];\n128|\n129|  useEffect(() => {\n130|    window.__circle = {\n131|      state: () => ({\n132|        \"location.precise\": loc.mode === \"precise\",\n133|        \"location.mode\": loc.mode,\n134|        \"location.prompt\": loc.prompt,\n135|        \"dm.policy\": dm.policy,\n136|        \"dm.inspected\": seen.includes(\"messages\") || seen.includes(\"dm_options\"),\n137|        \"st.limit\": st.limit,\n138|        \"st.reminders\": st.reminders,\n139|        \"st.viewed\": seen.includes(\"usage\"),\n140|        \"sub.active\": sub.active,\n141|        \"sub.plan\": sub.plan,\n142|        \"sub.offer\": sub.offer,\n143|        \"sub.terms_viewed\": seen.includes(\"terms\"),\n144|      }),\n145|      seeds: [...seeds],\n146|    };\n147|  }, [loc, dm, st, sub, seen, seeds]);\n148|\n149|  const push = (s: Screen) => {\n150|    setStack((stck) => [...stck, s]);\n151|    setSeen((prev) => (prev.includes(s) ? prev : [...prev, s]));\n152|  };\n153|  const pop = () => setStack((stck) => (stck.length > 1 ? stck.slice(0, -1) : stck));\n154|\n155|  /** Apply a location choice, routing through the confirm-shaming dialog when seeded. */\n156|  const choose = (mode: Mode, after?: () => void) => {\n157|    const commit = () => {\n158|      setLoc({ mode, prompt: \"answered\" });\n159|      setConfirm(null);\n160|      after?.();\n161|    };\n162|    if (mode !== \"precise\" && loc.mode === \"precise\" && has(\"LOC_CONFIRM_SHAME\")) {\n163|      setConfirm(() => commit);\n164|    } else {\n165|      commit();\n166|    }\n167|  };\n168|\n169|  const commitDm = (policy: DmPolicy) => {\n170|    setDm({ policy });\n171|    setDmConfirm(null);\n172|    setDmPending(null);\n173|  };\n174|\n175|  /** Apply a message-audience choice through seeded confirm/info overlays. */\n176|  const chooseDm = (policy: DmPolicy) => {\n177|    const viaInfo = () => {\n178|      if (has(\"DM_INFO_AFTER_CHOICE\")) setDmPending(policy);\n179|      else commitDm(policy);\n180|    };\n181|    if (policy === \"blocked\" && dm.policy !== \"blocked\" && has(\"DM_CONFIRM_BLOCK\")) {\n182|      setDmConfirm(() => viaInfo);\n183|    } else {\n184|      viaInfo();\n185|    }\n186|  };\n187|\n188|  const commitSt = (limit: number | null) => {\n189|    setSt((s) => ({ ...s, limit }));\n190|    setStPending(null);\n191|    setStConfirm(null);\n192|  };\n193|\n194|  /** Apply a daily-limit choice through seeded save/confirm friction. */\n195|  const chooseSt = (limit: number | null) => {\n196|    if (has(\"ST_REQUIRE_SAVE\")) {\n197|      setStPending({ value: limit });\n198|      return;\n199|    }\n200|    if (limit !== null && has(\"ST_CONFIRM_LIMIT\")) {\n201|      setStConfirm(() => () => commitSt(limit));\n202|    } else {\n203|      commitSt(limit);\n204|    }\n205|  };\n206|\n207|  const saveSt = () => {\n208|    if (!stPending) return;\n209|    const limit = stPending.value;\n210|    if (limit !== null && has(\"ST_CONFIRM_LIMIT\")) {\n211|      setStConfirm(() => () => commitSt(limit));\n212|    } else {\n213|      commitSt(limit);\n214|    }\n215|  };\n216|\n217|  const subscribe = () => setSub((s) => ({ ...s, active: true, offer: \"answered\" }));\n218|  const declineOffer = () => setSub((s) => ({ ...s, offer: \"answered\" }));\n219|\n220|  const requestCancel = () => {\n221|    if (has(\"SUB_RETENTION_OFFER\")) setSubRetain(true);\n222|    else setSub((s) => ({ ...s, active: false }));\n223|  };\n224|  const confirmCancel = () => {\n225|    setSub((s) => ({ ...s, active: false }));\n226|    setSubRetain(false);\n227|  };\n228|\n229|  const showPrompt = screen === \"home\" && loc.prompt === \"open\";\n230|  const dmOverlay = dmConfirm ? \"dm_confirm\" : dmPending ? \"dm_info\" : null;\n231|  const stOverlay = stConfirm ? \"st_confirm\" : null;\n232|  const subOverlay = subRetain ? \"sub_retain\" : null;\n233|  const overlay = confirm ? \"confirm_off\" : showPrompt ? \"location_prompt\" : (dmOverlay ?? stOverlay ?? subOverlay);\n234|  const copyTweak = has(\"UI_COPY_TWEAK\");\n235|  const posts = has(\"UI_FEED_SHUFFLE\") ? [...POSTS].reverse() : POSTS;\n236|  const stSelected = (v: number | null) =>\n237|    has(\"ST_REQUIRE_SAVE\") ? (stPending !== null && stPending.value === v) : st.limit === v;\n238|\n239|  return (\n240|    <div\n241|      className={dark ? \"app dark\" : \"app\"}\n242|      data-screen={overlay ? `${screen}+${overlay}` : screen}\n243|      style={has(\"UI_ACCENT\") ? ({ \"--accent\": \"#0e7a5f\" } as CSSProperties) : undefined}\n244|    >\n245|      <header className=\"bar\">\n246|        {stack.length > 1 ? (\n247|          <button className=\"icon\" data-agency=\"nav.back\" aria-label=\"Back\" onClick={pop}>\n248|            ‹\n249|          </button>\n250|        ) : (\n251|          <span className=\"icon\" />\n252|        )}\n253|        <h1 className={screen === \"home\" ? \"logo\" : \"\"}>{TITLES[screen]}</h1>\n254|        {screen === \"home\" ? (\n255|          <button className=\"icon\" data-agency=\"nav.settings\" aria-label=\"Settings\" onClick={() => push(\"settings\")}>\n256|            ⚙\n257|          </button>\n258|        ) : (\n259|          <span className=\"icon\" />\n260|        )}\n261|      </header>\n262|\n263|      <main>\n264|        {screen === \"home\" && <Feed posts={posts} />}\n265|\n266|        {screen === \"settings\" && (\n267|          <List>\n268|            {has(\"UI_REORDER_SETTINGS\") ? (\n269|              <>\n270|                <Row label=\"Help\" />\n271|                <Row label=\"Account\" />\n272|                <Row label=\"Notifications\" />\n273|              </>\n274|            ) : (\n275|              <>\n276|                <Row label=\"Account\" />\n277|                <Row label=\"Notifications\" />\n278|              </>\n279|            )}\n280|            <Row\n281|              label={has(\"UI_PRIVACY_COPY\") ? \"Messaging & privacy\" : \"Privacy\"}\n282|              tag=\"settings.privacy\"\n283|              onClick={() => push(\"privacy\")}\n284|            />\n285|            {!has(\"LOC_BURY_SETTING\") && (\n286|              <Row label=\"Location\" tag=\"settings.location\" onClick={() => push(\"location\")} />\n287|            )}\n288|            <Row label=\"Screen Time\" tag=\"settings.screentime\" onClick={() => push(\"screentime\")} />\n289|            <Row label=\"Circle+\" tag=\"settings.subscription\" onClick={() => push(\"plus\")} />\n290|            {has(\"UI_EXTRA_ROW\") && (\n291|              <Row label=\"Appearance\" tag=\"settings.appearance\" onClick={() => push(\"appearance\")} />\n292|            )}\n293|            {!has(\"UI_REORDER_SETTINGS\") && <Row label=\"Help\" />}\n294|          </List>\n295|        )}\n296|\n297|        {screen === \"privacy\" && (\n298|          <List>\n299|            <Row label={has(\"UI_PRIVACY_COPY\") ? \"Account visibility\" : \"Account privacy\"} />\n300|            {!has(\"DM_BURY_MESSAGES\") && (\n301|              <Row\n302|                label={has(\"UI_PRIVACY_COPY\") ? \"Who can message me\" : \"Messages\"}\n303|                tag=\"privacy.messages\"\n304|                onClick={() => push(\"messages\")}\n305|              />\n306|            )}\n307|            <Row label=\"Advanced\" tag=\"privacy.advanced\" onClick={() => push(\"advanced\")} />\n308|          </List>\n309|        )}\n310|\n311|        {screen === \"advanced\" && (\n312|          <List>\n313|            <Row label=\"Ad preferences\" />\n314|            {has(\"LOC_BURY_SETTING\") && (\n315|              <Row label=\"Location services\" tag=\"advanced.location\" onClick={() => push(\"location\")} />\n316|            )}\n317|            {has(\"DM_BURY_MESSAGES\") && (\n318|              <Row label=\"Messages\" tag=\"advanced.messages\" onClick={() => push(\"messages\")} />\n319|            )}\n320|            <Row label=\"Download your data\" />\n321|          </List>\n322|        )}\n323|\n324|        {screen === \"location\" && (\n325|          <List>\n326|            {has(\"LOC_NO_DIRECT_TOGGLE\") ? (\n327|              <Row label=\"Location options\" tag=\"location.open_options\" onClick={() => push(\"location_options\")} />\n328|            ) : (\n329|              <label className=\"row toggle-row\">\n330|                <span>\n331|                  Precise location\n332|                  <small>Share your exact location with Circle</small>\n333|                </span>\n334|                <input\n335|                  type=\"checkbox\"\n336|                  role=\"switch\"\n337|                  data-agency=\"location.toggle\"\n338|                  checked={loc.mode === \"precise\"}\n339|                  onChange={(e) => choose(e.target.checked ? \"precise\" : \"off\")}\n340|                />\n341|              </label>\n342|            )}\n343|          </List>\n344|        )}\n345|\n346|        {screen === \"location_options\" && <LocationOptions current={loc.mode} onSave={(m) => choose(m, pop)} />}\n347|\n348|        {screen === \"messages\" && (\n349|          <List>\n350|            <div className=\"note\">Teen account · {copyTweak ? \"pick who can reach you\" : \"Choose who can send you messages.\"}</div>\n351|            <Option\n352|              title=\"Everyone\"\n353|              sub=\"Anyone on Circle can message this account\"\n354|              tag=\"dm.allow_all\"\n355|              selected={dm.policy === \"everyone\"}\n356|              onPick={() => chooseDm(\"everyone\")}\n357|            />\n358|            <Option\n359|              title=\"Friends only\"\n360|              sub=\"Only people you follow back can message you\"\n361|              tag=\"dm.friends_only\"\n362|              selected={dm.policy === \"friends\"}\n363|              onPick={() => chooseDm(\"friends\")}\n364|            />\n365|            {!has(\"DM_HIDE_BLOCK\") ? (\n366|              <Option\n367|                title=\"Block unknown people\"\n368|                sub=\"Only friends can reach you; everyone else is blocked\"\n369|                tag=\"dm.block_unknown\"\n370|                selected={dm.policy === \"blocked\"}\n371|                onPick={() => chooseDm(\"blocked\")}\n372|              />\n373|            ) : (\n374|              <Row label=\"More options\" tag=\"dm.more\" onClick={() => push(\"dm_options\")} />\n375|            )}\n376|          </List>\n377|        )}\n378|\n379|        {screen === \"dm_options\" && (\n380|          <List>\n381|            <Option\n382|              title=\"Block unknown people\"\n383|              sub=\"Only friends can reach you; everyone else is blocked\"\n384|              tag=\"dm.block_unknown\"\n385|              selected={dm.policy === \"blocked\"}\n386|              onPick={() => chooseDm(\"blocked\")}\n387|            />\n388|          </List>\n389|        )}\n390|\n391|        {screen === \"screentime\" && (\n392|          <List>\n393|            <div className=\"stat\">\n394|              <span className=\"big\">1h 24m</span>\n395|              <small>Today · daily average this week 1h 41m</small>\n396|            </div>\n397|            <label className=\"row toggle-row\">\n398|              <span>\n399|                Break reminders\n400|                <small>Nudge me to take a break every 30 minutes</small>\n401|              </span>\n402|              <input\n403|                type=\"checkbox\"\n404|                role=\"switch\"\n405|                data-agency=\"st.reminders\"\n406|                checked={st.reminders}\n407|                onChange={(e) => setSt((s) => ({ ...s, reminders: e.target.checked }))}\n408|              />\n409|            </label>\n410|            {!has(\"ST_BURY_LIMIT\") ? (\n411|              <Row\n412|                label=\"Daily limit\"\n413|                detail={limitLabel(st.limit)}\n414|                tag=\"screentime.limit\"\n415|                onClick={() => push(\"st_limit\")}\n416|              />\n417|            ) : (\n418|              <Row label=\"More settings\" tag=\"screentime.more\" onClick={() => push(\"st_more\")} />\n419|            )}\n420|            <Row label=\"See today's usage\" tag=\"screentime.usage\" onClick={() => push(\"usage\")} />\n421|          </List>\n422|        )}\n423|\n424|        {screen === \"st_more\" && (\n425|          <List>\n426|            <Row\n427|              label=\"Daily limit\"\n428|              detail={limitLabel(st.limit)}\n429|              tag=\"st.open_limit\"\n430|              onClick={() => push(\"st_limit\")}\n431|            />\n432|            <Row label=\"Notification settings\" />\n433|          </List>\n434|        )}\n435|\n436|        {screen === \"st_limit\" && (\n437|          <>\n438|            <List>\n439|              {!has(\"ST_HIDE_REMOVE\") ? (\n440|                <Option\n441|                  title=\"No limit\"\n442|                  sub=\"Use Circle without a daily cap\"\n443|                  tag=\"st.limit_off\"\n444|                  selected={stSelected(null)}\n445|                  onPick={() => chooseSt(null)}\n446|                />\n447|              ) : (\n448|                <Row label=\"More options\" tag=\"st.more\" onClick={() => push(\"st_remove\")} />\n449|              )}\n450|              {!has(\"ST_MIN_LIMIT_2H\") && (\n451|                <Option\n452|                  title=\"1 hour a day\"\n453|                  sub=\"Pause my feed after 1 hour\"\n454|                  tag=\"st.limit_1h\"\n455|                  selected={stSelected(60)}\n456|                  onPick={() => chooseSt(60)}\n457|                />\n458|              )}\n459|              <Option\n460|                title=\"2 hours a day\"\n461|                sub=\"Pause my feed after 2 hours\"\n462|                tag=\"st.limit_2h\"\n463|                selected={stSelected(120)}\n464|                onPick={() => chooseSt(120)}\n465|              />\n466|              <Option\n467|                title=\"4 hours a day\"\n468|                sub=\"Pause my feed after 4 hours\"\n469|                tag=\"st.limit_4h\"\n470|                selected={stSelected(240)}\n471|                onPick={() => chooseSt(240)}\n472|              />\n473|            </List>\n474|            {has(\"ST_REQUIRE_SAVE\") && (\n475|              <div className=\"footer\">\n476|                <button className=\"primary\" data-agency=\"st.save_limit\" onClick={saveSt}>\n477|                  Save\n478|                </button>\n479|              </div>\n480|            )}\n481|          </>\n482|        )}\n483|\n484|        {screen === \"st_remove\" && (\n485|          <>\n486|            <div className=\"note\">Removing your limit means Circle will no longer pause your feed.</div>\n487|            <div className=\"footer\">\n488|              <button\n489|                className=\"primary\"\n490|                data-agency=\"st.limit_off\"\n491|                onClick={() => {\n492|                  commitSt(null);\n493|                  pop();\n494|                }}\n495|              >\n496|                Remove limit\n497|              </button>\n498|            </div>\n499|          </>\n500|        )}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b9","stream":{"kind":"session","id":"01a19ab8-fe17-7081-829e-1170c6a57ef1"},"sequence":55,"recorded_at":1780531400000105,"record_type":"event","durability":"durable","causation_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","run_stream":{"kind":"run","id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92"},"call_id":"call_01a19ab90934706c9b9b0539d4b0cc89","text":"Read text file `apps/circle/src/seeds.ts`.\n1|// Every deliberate agency regression in Circle is a named seed. Baseline runs\n2|// with no seeds, candidate with all of them, and the benchmark can switch each\n3|// one on in isolation (?seeds=DM_HIDE_BLOCK) to measure per-seed recall.\n4|// Ground truth for each seed lives in eval/ground_truth.json.\n5|//\n6|// Seeds prefixed LOC/DM/ST/SUB change the cost, visibility, default or success\n7|// of an intent. Seeds prefixed UI are no-change controls: cosmetic tweaks that\n8|// must not move any intent's numbers, so we can measure false alarms.\n9|\n10|export const SEEDS = {\n11|  /** Prompt offers \"Continue\" + \"More options\"; declining lives one screen deeper. */\n12|  LOC_HIDE_DECLINE: \"Decline hidden behind More options\",\n13|  /** Precise location starts on before the user has chosen anything. */\n14|  LOC_DEFAULT_ON: \"Precise location on by default\",\n15|  /** Turning precise location off asks for confirmation with loss framing. */\n16|  LOC_CONFIRM_SHAME: \"Confirm-shaming dialog on turning location off\",\n17|  /** Location settings move from Settings to Settings > Privacy > Advanced. */\n18|  LOC_BURY_SETTING: \"Location setting buried under Privacy > Advanced\",\n19|  /** Location settings offer an options screen instead of a direct toggle. */\n20|  LOC_NO_DIRECT_TOGGLE: \"Direct location toggle replaced by options screen\",\n21|  /** \"Block unknown people\" hides behind More options on the messages screen. */\n22|  DM_HIDE_BLOCK: \"Block-unknown option hidden behind More options\",\n23|  /** Messaging a teen defaults to open to everyone instead of friends only. */\n24|  DM_DEFAULT_EVERYONE: \"Message audience defaults to everyone\",\n25|  /** Messages move from Privacy to Privacy > Advanced. */\n26|  DM_BURY_MESSAGES: \"Message setting buried under Privacy > Advanced\",\n27|  /** Choosing to block unknown people asks for confirmation with loss framing. */\n28|  DM_CONFIRM_BLOCK: \"Confirm-shaming dialog on blocking unknown messages\",\n29|  /** What each audience option means appears only after choosing, not before. */\n30|  DM_INFO_AFTER_CHOICE: \"Audience explanations shown after commitment\",\n31|  /** Removing a screen-time limit hides behind More options on the limit screen. */\n32|  ST_HIDE_REMOVE: \"Remove-limit hidden behind More options\",\n33|  /** The 1-hour preset disappears; the smallest limit on offer is 2 hours. */\n34|  ST_MIN_LIMIT_2H: \"Smallest daily limit raised to 2 hours\",\n35|  /** Daily limit moves from Screen Time to Screen Time > More settings. */\n36|  ST_BURY_LIMIT: \"Daily limit buried under More settings\",\n37|  /** Setting a daily limit asks for confirmation with loss framing. */\n38|  ST_CONFIRM_LIMIT: \"Confirm-shaming dialog on setting a daily limit\",\n39|  /** Limit presets only select; a separate Save commits the choice. */\n40|  ST_REQUIRE_SAVE: \"Limit choice needs an extra Save tap\",\n41|  /** Declining Circle+ hides behind More options on the offer screen. */\n42|  SUB_HIDE_DECLINE: \"Decline hidden behind More options\",\n43|  /** Cancelling moves from Billing to Billing > Manage plan > Other options. */\n44|  SUB_BURY_CANCEL: \"Cancel buried under Billing > Manage plan > Other\",\n45|  /** The offer preselects the annual plan instead of monthly. */\n46|  SUB_DEFAULT_ANNUAL: \"Circle+ plan defaults to annual\",\n47|  /** Cancelling routes through a retention offer that must be dismissed. */\n48|  SUB_RETENTION_OFFER: \"Retention offer shown before cancelling\",\n49|  /** Price and renewal terms appear only after subscribing, not before. */\n50|  SUB_TERMS_AFTER_CHECKOUT: \"Renewal terms shown after commitment\",\n51|  /** Control: reworded headings and buttons, same layout and tags. */\n52|  UI_COPY_TWEAK: \"Control: copy tweak\",\n53|  /** Control: teal accent instead of blue. */\n54|  UI_ACCENT: \"Control: accent colour\",\n55|  /** Control: settings rows in a different order, same screens and taps. */\n56|  UI_REORDER_SETTINGS: \"Control: settings order\",\n57|  /** Control: feed posts in reverse order. */\n58|  UI_FEED_SHUFFLE: \"Control: feed order\",\n59|  /** Control: reworded privacy rows, same destinations. */\n60|  UI_PRIVACY_COPY: \"Control: privacy copy\",\n61|  /** Control: an extra Appearance row that leads nowhere agency-relevant. */\n62|  UI_EXTRA_ROW: \"Control: extra settings row\",\n63|} as const;\n64|\n65|export type SeedId = keyof typeof SEEDS;\n66|\n67|/** Seeds baked into the build with e.g. `VITE_SEEDS=SUB_HIDE_DECLINE vite build`,\n68| *  so a real pull request can carry a real regression without query flags. */\n69|function bakedSeeds(): Set<SeedId> {\n70|  const raw = import.meta.env?.VITE_SEEDS;\n71|  if (typeof raw !== \"string\" || raw.trim() === \"\") return new Set();\n72|  return new Set(raw.split(\",\").filter((s): s is SeedId => s in SEEDS));\n73|}\n74|\n75|export function activeSeeds(params: URLSearchParams): Set<SeedId> {\n76|  const explicit = params.get(\"seeds\");\n77|  if (explicit !== null) {\n78|    return new Set(explicit.split(\",\").filter((s): s is SeedId => s in SEEDS));\n79|  }\n80|  const seeds =\n81|    params.get(\"variant\") === \"candidate\" ? new Set(Object.keys(SEEDS) as SeedId[]) : new Set<SeedId>();\n82|  for (const s of bakedSeeds()) seeds.add(s);\n83|  return seeds;\n84|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3bb","stream":{"kind":"session","id":"01a19ab8-fe17-7081-829e-1170c6a57ef1"},"sequence":56,"recorded_at":1780531400000107,"record_type":"event","durability":"durable","causation_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","run_stream":{"kind":"run","id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92"},"call_id":"call_01a19ab90a1d76c895fc3f127e93ea08","text":"Read text file `apps/circle/src/main.tsx`.\n1|import { createRoot } from \"react-dom/client\";\n2|import { App } from \"./App\";\n3|import \"./styles.css\";\n4|\n5|createRoot(document.getElementById(\"root\")!).render(<App />);","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3bd","stream":{"kind":"session","id":"01a19ab8-fe17-7081-829e-1170c6a57ef1"},"sequence":57,"recorded_at":1780531400000109,"record_type":"event","durability":"durable","causation_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92","run_stream":{"kind":"run","id":"01a19ab9-0344-7d02-b7a7-c6b25bf29c92"},"call_id":"call_01a19ab90b05779dbf750dbac45de609","text":"Read text file `apps/circle/src/styles.css`.\n1|:root {\n2|  --bg: #fafafa;\n3|  --card: #ffffff;\n4|  --ink: #111318;\n5|  --muted: #6b7280;\n6|  --line: #e5e7eb;\n7|  --accent: #2f6bff;\n8|  font-family: -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n9|  color: var(--ink);\n10|  background: var(--bg);\n11|}\n12|* { box-sizing: border-box; }\n13|body { margin: 0; }\n14|button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }\n15|\n16|.app { max-width: 430px; min-height: 100vh; margin: 0 auto; background: var(--card); position: relative; }\n17|\n18|.bar {\n19|  position: sticky; top: 0; z-index: 2;\n20|  display: flex; align-items: center; justify-content: space-between;\n21|  height: 56px; padding: 0 8px; background: var(--card); border-bottom: 1px solid var(--line);\n22|}\n23|.bar h1 { font-size: 17px; margin: 0; font-weight: 600; }\n24|.bar h1.logo { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }\n25|.icon { width: 44px; height: 44px; font-size: 24px; display: grid; place-items: center; }\n26|\n27|.feed { padding: 8px 0; }\n28|.post { padding: 8px 0 16px; }\n29|.post .who { display: flex; align-items: center; gap: 10px; padding: 0 14px 8px; font-weight: 600; font-size: 14px; }\n30|.post .avatar { width: 32px; height: 32px; border-radius: 50%; }\n31|.post .photo { aspect-ratio: 1 / 1; }\n32|.post p { margin: 10px 14px 0; font-size: 14px; }\n33|\n34|.list { display: flex; flex-direction: column; }\n35|.row {\n36|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n37|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n38|  border-bottom: 1px solid var(--line);\n39|}\n40|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n41|.chev { color: var(--muted); font-size: 22px; }\n42|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n43|.radio-row { justify-content: flex-start; }\n44|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n45|.footer { padding: 20px 18px; }\n46|\n47|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n48|.sheet {\n49|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n50|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n51|}\n52|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n53|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n54|.pin { font-size: 34px; }\n55|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n56|\n57|.primary, .secondary { height: 48px; border-radius: 12px; font-weight: 600; font-size: 15px; width: 100%; }\n58|.primary { background: var(--accent); color: #fff; }\n59|.secondary { background: #eef1f6; }\n60|.link { color: var(--muted); font-size: 13px; padding: 6px; }\n61|\n62|.dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; }\n63|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--card); }\n64|.stat { padding: 18px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }\n65|.stat .big { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n66|.stat small { color: var(--muted); font-size: 13px; }\n67|.note { padding: 14px 18px; color: var(--muted); font-size: 14px; line-height: 1.45; border-bottom: 1px solid var(--line); }\n68|\n69|.app.dark {\n70|  --bg: #14161a;\n71|  --card: #1d2026;\n72|  --ink: #eef1f6;\n73|  --muted: #9aa1ad;\n74|  --line: #2c313a;\n75|}\n76|.app.dark .secondary { background: #2c313a; }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
