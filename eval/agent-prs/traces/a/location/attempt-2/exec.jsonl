urs\"\n532|                tag=\"st.limit_2h\"\n533|                selected={stSelected(120)}\n534|                onPick={() => chooseSt(120)}\n535|              />\n536|              <Option\n537|                title=\"4 hours a day\"\n538|                sub=\"Pause my feed after 4 hours\"\n539|                tag=\"st.limit_4h\"\n540|                selected={stSelected(240)}\n541|                onPick={() => chooseSt(240)}\n542|              />\n543|            </List>\n544|            {false && (\n545|              <div className=\"footer\">\n546|                <button className=\"primary\" data-agency=\"st.save_limit\" onClick={saveSt}>\n547|                  Save\n548|                </button>\n549|              </div>\n550|            )}\n551|          </>\n552|        )}\n553|\n554|        {screen === \"st_remove\" && (\n555|          <>\n556|            <div className=\"note\">Removing your limit means Circle will no longer pause your feed.</div>\n557|            <div className=\"footer\">\n558|              <button\n559|                className=\"primary\"\n560|                data-agency=\"st.limit_off\"\n561|                onClick={() => {\n562|                  commitSt(null);\n563|                  pop();\n564|                }}\n565|              >\n566|                Remove limit\n567|              </button>\n568|            </div>\n569|          </>\n570|        )}\n571|\n572|        {screen === \"usage\" && (\n573|          <List>\n574|            <div className=\"stat\">\n575|              <span className=\"big\">1h 24m</span>\n576|              <small>Today</small>\n577|            </div>\n578|            <div className=\"stat\">\n579|              <span className=\"big\">11h 47m</span>\n580|              <small>This week</small>\n581|            </div>\n582|            <div className=\"note\">Most time in Feed · evenings after 8pm</div>\n583|          </List>\n584|        )}\n585|\n586|        {screen === \"plus\" && (\n587|          <>