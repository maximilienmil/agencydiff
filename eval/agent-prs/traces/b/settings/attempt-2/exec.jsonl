gency=\"location.keep\" onClick={() => setConfirm(null)}>\n769|              Keep precise location\n770|            </button>\n771|            <button className=\"link\" data-agency=\"location.confirm_off\" onClick={confirm}>\n772|              Turn off anyway\n773|            </button>\n774|          </div>\n775|        </div>\n776|      )}\n777|\n778|      {dmConfirm && (\n779|        <div className=\"scrim\">\n780|          <div className=\"sheet\" role=\"dialog\">\n781|            <h2>Block new message requests?</h2>\n782|            <p>You&apos;ll miss messages from new friends and people trying to reach you.</p>\n783|            <button className=\"primary\" data-agency=\"dm.keep_open\" onClick={() => setDmConfirm(null)}>\n784|              Keep messages open\n785|            </button>\n786|            <button className=\"link\" data-agency=\"dm.confirm_block\" onClick={dmConfirm}>\n787|              Block anyway\n788|            </button>\n789|          </div>\n790|        </div>\n791|      )}\n792|\n793|      {dmPending && (\n794|        <div className=\"scrim\">\n795|          <div className=\"sheet\" role=\"dialog\">\n796|            <h2>What this means</h2>\n797|            <p>{AUDIENCE_INFO[dmPending]}</p>\n798|            <button className=\"primary\" data-agency=\"dm.info_continue\" onClick={() => commitDm(dmPending)}>\n799|              Continue\n800|            </button>\n801|          </div>\n802|        </div>\n803|      )}\n804|\n805|      {stConfirm && (\n806|        <div className=\"scrim\">\n807|          <div className=\"sheet\" role=\"dialog\">\n808|            <h2>Set a daily limit?</h2>\n809|            <p>Circle will pause your feed when time runs out, including during video calls.</p>\n810|            <button\n811|              className=\"primary\"\n812|              data-agency=\"st.keep_unlimited\"\n813|              onClick={() => {\n814|                setStConfirm(null);\n815|                setStPending(null);\n816|              }}