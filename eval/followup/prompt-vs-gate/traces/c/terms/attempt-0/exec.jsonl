{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c387","stream":{"kind":"session","id":"01a19f65-22bb-7811-b046-335be3624a9b"},"sequence":30,"recorded_at":1780531400000055,"record_type":"event","durability":"durable","causation_id":"01a19f65-278b-70f3-82ad-d8c462b29d63","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19f65-278b-70f3-82ad-d8c462b29d63","run_stream":{"kind":"run","id":"01a19f65-278b-70f3-82ad-d8c462b29d63"},"call_id":"call_01a19f652bf6753fb2023722e537ca53","text":"Read text file `apps/circle/src/App.tsx`.\n1|import { useEffect, useMemo, useState } from \"react\";\n2|import type { CSSProperties } from \"react\";\n3|\n4|import { Icon, ROW_ICONS } from \"./icons\";\n5|\n6|// Circle: a small social app. Interactive controls carry `data-agency` tags\n7|// and the root carries `data-screen`.\n8|\n9|type Screen =\n10|  | \"home\" | \"settings\" | \"privacy\" | \"advanced\" | \"location\" | \"location_options\"\n11|  | \"messages\" | \"dm_options\"\n12|  | \"screentime\" | \"st_more\" | \"st_limit\" | \"st_remove\" | \"usage\"\n13|  | \"plus\" | \"decline_options\" | \"terms\" | \"billing\" | \"plan_manage\" | \"cancel_other\"\n14|  | \"appearance\";\n15|type Mode = \"precise\" | \"approximate\" | \"off\";\n16|type DmPolicy = \"everyone\" | \"friends\" | \"blocked\";\n17|type SubPlan = \"monthly\" | \"annual\";\n18|\n19|interface LocationState {\n20|  mode: Mode;\n21|  prompt: \"open\" | \"answered\";\n22|}\n23|\n24|interface DmState {\n25|  policy: DmPolicy;\n26|}\n27|\n28|interface StState {\n29|  limit: number | null;\n30|  reminders: boolean;\n31|}\n32|\n33|interface SubState {\n34|  active: boolean;\n35|  plan: SubPlan;\n36|  offer: \"open\" | \"answered\";\n37|}\n38|\n39|const TITLES: Record<Screen, string> = {\n40|  home: \"Circle\",\n41|  settings: \"Settings\",\n42|  privacy: \"Privacy\",\n43|  advanced: \"Advanced\",\n44|  location: \"Location\",\n45|  location_options: \"Location options\",\n46|  messages: \"Messages\",\n47|  dm_options: \"Message options\",\n48|  screentime: \"Screen Time\",\n49|  st_more: \"More settings\",\n50|  st_limit: \"Daily limit\",\n51|  st_remove: \"Remove limit\",\n52|  usage: \"Your time\",\n53|  plus: \"Circle+\",\n54|  decline_options: \"More options\",\n55|  terms: \"Renewal terms\",\n56|  billing: \"Billing\",\n57|  plan_manage: \"Manage plan\",\n58|  cancel_other: \"Other options\",\n59|  appearance: \"Appearance\",\n60|};\n61|\n62|function initialLocation(params: URLSearchParams): LocationState {\n63|  if (params.get(\"fixture\") === \"location-shared\") return { mode: \"precise\", prompt: \"answered\" };\n64|  // Any other fixture means the probe starts past onboarding: the location\n65|  // prompt is answered and out of the way of the decision under test.\n66|  if (params.get(\"fixture\")) return { mode: \"off\", prompt: \"answered\" };\n67|  return { mode: \"off\", prompt: \"open\" };\n68|}\n69|\n70|function initialDm(params: URLSearchParams): DmState {\n71|  if (params.get(\"fixture\") === \"dm-restricted\") return { policy: \"blocked\" };\n72|  return { policy: \"friends\" };\n73|}\n74|\n75|function initialSt(params: URLSearchParams): StState {\n76|  if (params.get(\"fixture\") === \"limit-set\") return { limit: 480, reminders: false };\n77|  return { limit: null, reminders: false };\n78|}\n79|\n80|function initialSub(params: URLSearchParams): SubState {\n81|  const fixture = params.get(\"fixture\");\n82|  if (fixture === \"subscribed\") return { active: true, plan: \"monthly\", offer: \"answered\" };\n83|  if (fixture === \"cancelled\") return { active: false, plan: \"monthly\", offer: \"answered\" };\n84|  return { active: false, plan: \"monthly\", offer: \"open\" };\n85|}\n86|\n87|declare global {\n88|  interface Window {\n89|    __circle?: { state: () => Record<string, unknown> };\n90|  }\n91|}\n92|\n93|const AUDIENCE_INFO: Record<DmPolicy, string> = {\n94|  everyone: \"Anyone on Circle will be able to send messages to this account, including people you don't know.\",\n95|  friends: \"Only people you follow back will be able to message this account.\",\n96|  blocked: \"People you don't know will be blocked from messaging this account.\",\n97|};\n98|\n99|function limitLabel(limit: number | null): string {\n100|  if (limit === null) return \"Off\";\n101|  const h = limit / 60;\n102|  return `${h} hour${h === 1 ? \"\" : \"s\"} a day`;\n103|}\n104|\n105|const PLAN_NAME: Record<SubPlan, string> = { monthly: \"Monthly\", annual: \"Annual\" };\n106|const PLAN_PRICE: Record<SubPlan, string> = { monthly: \"$4.99/mo\", annual: \"$47.99/yr\" };\n107|\n108|export function App() {\n109|  const params = useMemo(() => new URLSearchParams(location.search), []);\n110|  const has = (_s: string) => false;\n111|\n112|  const [loc, setLoc] = useState<LocationState>(() => initialLocation(params));\n113|  const [dm, setDm] = useState<DmState>(() => initialDm(params));\n114|  const [st, setSt] = useState<StState>(() => initialSt(params));\n115|  const [sub, setSub] = useState<SubState>(() => initialSub(params));\n116|  const [stack, setStack] = useState<Screen[]>([\"home\"]);\n117|  const [seen, setSeen] = useState<string[]>([]);\n118|  const [confirm, setConfirm] = useState<null | (() => void)>(null);\n119|  const [dmConfirm, setDmConfirm] = useState<null | (() => void)>(null);\n120|  const [dmPending, setDmPending] = useState<DmPolicy | null>(null);\n121|  const [stPending, setStPending] = useState<{ value: number | null } | null>(null);\n122|  const [stConfirm, setStConfirm] = useState<null | (() => void)>(null);\n123|  const [subRetain, setSubRetain] = useState(false);\n124|  const [dark, setDark] = useState(false);\n125|  // Optional sign-in gate: behind ?auth=1 the app shows a\n126|  // sign-in screen until the test user is authenticated. The session\n127|  // persists in localStorage so a saved storageState file carries it.\n128|  const needsAuth = params.get(\"auth\") === \"1\";\n129|  const [authed, setAuthed] = useState(() => !needsAuth || localStorage.getItem(\"circle.auth\") === \"1\");\n130|  const [loginUser, setLoginUser] = useState(\"\");\n131|  const [loginPass, setLoginPass] = useState(\"\");\n132|  const [loginError, setLoginError] = useState<string | null>(null);\n133|  const screen = stack[stack.length - 1];\n134|  // The fictional-app notice is for people. Automated browsers skip it so\n135|  // their screenshots show only the app; ?banner=1 forces it back on.\n136|  const showBanner = !navigator.webdriver || params.has(\"banner\");\n137|\n138|  const signIn = () => {\n139|    // Demo gate only, not a real credential check: the documented test\n140|    // user signs in with any non-empty password; anything else is refused.\n141|    if (loginUser === \"test-user\" && loginPass.length > 0) {\n142|      localStorage.setItem(\"circle.auth\", \"1\");\n143|      setAuthed(true);\n144|    } else {\n145|      setLoginError(\"Use the test account test-user with any password.\");\n146|    }\n147|  };\n148|\n149|  useEffect(() => {\n150|    window.__circle = {\n151|      state: () => ({\n152|        \"auth.signedIn\": needsAuth ? authed : true,\n153|        \"location.precise\": loc.mode === \"precise\",\n154|        \"location.mode\": loc.mode,\n155|        \"location.prompt\": loc.prompt,\n156|        \"dm.policy\": dm.policy,\n157|        \"dm.inspected\": seen.includes(\"messages\") || seen.includes(\"dm_options\"),\n158|        \"st.limit\": st.limit,\n159|        \"st.reminders\": st.reminders,\n160|        \"st.viewed\": seen.includes(\"usage\"),\n161|        \"sub.active\": sub.active,\n162|        \"sub.plan\": sub.plan,\n163|        \"sub.offer\": sub.offer,\n164|        \"sub.terms_viewed\": seen.includes(\"terms\"),\n165|      }),\n166|    };\n167|  }, [loc, dm, st, sub, seen, needsAuth, authed]);\n168|\n169|  const push = (s: Screen) => {\n170|    setStack((stck) => [...stck, s]);\n171|    setSeen((prev) => (prev.includes(s) ? prev : [...prev, s]));\n172|  };\n173|  const pop = () => setStack((stck) => (stck.length > 1 ? stck.slice(0, -1) : stck));\n174|\n175|  /** Apply a location choice. */\n176|  const choose = (mode: Mode, after?: () => void) => {\n177|    const commit = () => {\n178|      setLoc({ mode, prompt: \"answered\" });\n179|      setConfirm(null);\n180|      after?.();\n181|    };\n182|    if (mode !== \"precise\" && loc.mode === \"precise\" && false) {\n183|      setConfirm(() => commit);\n184|    } else {\n185|      commit();\n186|    }\n187|  };\n188|\n189|  const commitDm = (policy: DmPolicy) => {\n190|    setDm({ policy });\n191|    setDmConfirm(null);\n192|    setDmPending(null);\n193|  };\n194|\n195|  /** Apply a message-audience choice. */\n196|  const chooseDm = (policy: DmPolicy) => {\n197|    const viaInfo = () => {\n198|      if (false) setDmPending(policy);\n199|      else commitDm(policy);\n200|    };\n201|    if (policy === \"blocked\" && dm.policy !== \"blocked\" && false) {\n202|      setDmConfirm(() => viaInfo);\n203|    } else {\n204|      viaInfo();\n205|    }\n206|  };\n207|\n208|  const commitSt = (limit: number | null) => {\n209|    setSt((s) => ({ ...s, limit }));\n210|    setStPending(null);\n211|    setStConfirm(null);\n212|  };\n213|\n214|  /** Apply a daily-limit choice. */\n215|  const chooseSt = (limit: number | null) => {\n216|    if (false) {\n217|      setStPending({ value: limit });\n218|      return;\n219|    }\n220|    if (limit !== null && false) {\n221|      setStConfirm(() => () => commitSt(limit));\n222|    } else {\n223|      commitSt(limit);\n224|    }\n225|  };\n226|\n227|  const saveSt = () => {\n228|    if (!stPending) return;\n229|    const limit = stPending.value;\n230|    if (limit !== null && false) {\n231|      setStConfirm(() => () => commitSt(limit));\n232|    } else {\n233|      commitSt(limit);\n234|    }\n235|  };\n236|\n237|  const subscribe = () => setSub((s) => ({ ...s, active: true, offer: \"answered\" }));\n23