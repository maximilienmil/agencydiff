n530|                    onPick={() => setSub((s) => ({ ...s, plan: \"monthly\" }))}\n531|                  />\n532|                  <Option\n533|                    title={`Annual · ${PLAN_PRICE.annual}`}\n534|                    sub=\"Renews every year until you cancel\"\n535|                    tag=\"sub.plan_annual\"\n536|                    selected={sub.plan === \"annual\"}\n537|                    onPick={() => setSub((s) => ({ ...s, plan: \"annual\" }))}\n538|                  />\n539|                </>\n540|              ) : (\n541|                <div className=\"note\">\n542|                  Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]} · active\n543|                </div>\n544|              )}\n545|            </List>\n546|            {!sub.active ? (\n547|              <>\n548|                {!has(\"SUB_TERMS_AFTER_CHECKOUT\") && (\n549|                  <div className=\"note\">\n550|                    {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}, renews automatically. Cancel anytime in Settings.\n551|                  </div>\n552|                )}\n553|                <div className=\"footer\">\n554|                  <button className=\"primary\" data-agency=\"sub.subscribe\" onClick={subscribe}>\n555|                    {copyTweak ? \"Get Circle+\" : \"Subscribe\"}\n556|                  </button>\n557|                  {!has(\"SUB_HIDE_DECLINE\") ? (\n558|                    <button className=\"link\" data-agency=\"sub.decline\" onClick={declineOffer}>\n559|                      {copyTweak ? \"Maybe later\" : \"Not now\"}\n560|                    </button>\n561|                  ) : (\n562|                    <button className=\"link\" data-agency=\"sub.more\" onClick={() => push(\"decline_options\")}>\n563|                      More options\n564|                    </button>\n565|                  )}\n566|                </div>\n567|                <List>\n568|                  {!has(\"SUB_TERMS_AFTER_CHECKOUT\") ? (\n569|                    <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n570|                  ) : (\n571|                    <div className=\"note\">Full terms are shown after checkout.</div>\n572|                  )}\n573|                </List>\n574|              </>\n575|            ) : (\n576|              <List>\n577|                <Row label=\"Manage subscription\" tag=\"sub.manage\" onClick={() => push(\"billing\")} />\n578|                <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n579|              </List>\n580|            )}\n581|          </>\n582|        )}\n583|\n584|        {screen === \"decline_options\" && (\n585|          <>\n586|            <div className=\"note\">No problem. Circle stays free, and you can join Circle+ anytime.</div>\n587|            <div className=\"footer\">\n588|              <button\n589|                className=\"link\"\n590|                data-agency=\"sub.decline\"\n591|                onClick={() => {\n592|                  declineOffer();\n593|                  pop();\n594|                }}\n595|              >\n596|                Not now\n597|              </button>\n598|            </div>\n599|          </>\n600|        )}\n601|\n602|        {screen === \"terms\" && (\n603|          <List>\n604|            <div className=\"note\">\n605|              Circle+ {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}. Your plan renews automatically each{\" \"}\n606|              {sub.plan === \"monthly\" ? \"month\" : \"year\"} until you cancel. Cancel anytime in Settings · Billing;\n607|              you keep Circle+ until the end of the paid period.\n608|            </div>\n609|          </List>\n610|        )}\n611|\n612|        {screen === \"billing\" && (\n613|          <List>\n614|            <div className=\"note\">\n615|              Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}\n616|            </div>\n617|            {has(\"SUB_BURY_CANCEL\") ? (\n618|              <Row label=\"Manage plan\" tag=\"sub.billing_manage\" onClick={() => push(\"plan_manage\")} />\n619|            ) : (\n620|              <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n621|            )}\n622|          </List>\n623|        )}\n624|\n625|        {screen === \"plan_manage\" && (\n626|          <List>\n627|            <Row label=\"Change plan\" />\n628|            <Row label=\"Pause plan\" />\n629|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n630|          </List>\n631|        )}\n632|\n633|        {screen === \"cancel_other\" && (\n634|          <List>\n635|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n636|          </List>\n637|        )}\n638|\n639|        {screen === \"appearance\" && (\n640|          <List>\n641|            <Option\n642|              title=\"Light\"\n643|              sub=\"Default bright theme\"\n644|              tag=\"appearance.light\"\n645|              selected={!dark}\n646|              onPick={() => setDark(false)}\n647|            />\n648|            <Option\n649|              title=\"Dark\"\n650|              sub=\"Dim the interface in the evening\"\n651|              tag=\"appearance.dark\"\n652|              selected={dark}\n653|              onPick={() => setDark(true)}\n654|            />\n655|          </List>\n656|        )}\n657|      </main>\n658|\n659|      {showPrompt && !confirm && (\n660|        <div className=\"scrim\">\n661|          <div className=\"sheet\" role=\"dialog\">\n662|            {has(\"LOC_HIDE_DECLINE\") ? (\n663|              <>\n664|                <div className=\"pin\">📍</div>\n665|                <h2>Find friends and events near you</h2>\n666|                <p>Circle works best with your precise location.</p>\n667|                <button className=\"primary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n668|                  Continue\n669|                </button>\n670|                <button className=\"link\" data-agency=\"location.more\" onClick={() => push(\"location_options\")}>\n671|                  More options\n672|                </button>\n673|              </>\n674|            ) : (\n675|              <>\n676|                <div className=\"pin\">📍</div>\n677|                <h2>{copyTweak ? \"Let Circle know where you are?\" : \"Allow Circle to use your precise location?\"}</h2>\n678|                <p>Used to show friends and events near you. You can change this anytime in Settings.</p>\n679|                <div className=\"pair\">\n680|                  <button className=\"secondary\" data-agency=\"location.decline\" onClick={() => choose(\"off\")}>\n681|                    Not now\n682|                  </button>\n683|                  <button className=\"secondary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n684|                    Allow precise location\n685|                  </button>\n686|                </div>\n687|              </>\n688|            )}\n689|          </div>\n690|        </div>\n691|      )}\n692|\n693|      {confirm && (\n694|        <div className=\"scrim\">\n695|          <div className=\"sheet\" role=\"dialog\">\n696|            <h2>Are you sure?</h2>\n697|            <p>Without precise location you&apos;ll miss friends and events happening near you.</p>\n698|            <button className=\"primary\" data-agency=\"location.keep\" onClick={() => setConfirm(null)}>\n699|              Keep precise location\n700|            </button>\n701|            <button className=\"link\" data-agency=\"location.confirm_off\" onClick={confirm}>\n702|              Turn off anyway\n703|            </button>\n704|          </div>\n705|        </div>\n706|      )}\n707|\n708|      {dmConfirm && (\n709|        <div className=\"scrim\">\n710|          <div className=\"sheet\" role=\"dialog\">\n711|            <h2>Block new message requests?</h2>\n712|            <p>You&apos;ll miss messages from new friends and people trying to reach you.</p>\n713|            <button className=\"primary\" data-agency=\"dm.keep_open\" onClick={() => setDmConfirm(null)}>\n714|              Keep messages open\n715|            </button>\n716|            <button className=\"link\" data-agency=\"dm.confirm_block\" onClick={dmConfirm}>\n717|              Block anyway\n718|            </button>\n719|          </div>\n720|        </div>\n721|      )}\n722|\n723|      {dmPending && (\n724|        <div className=\"scrim\">\n725|          <div className=\"sheet\" role=\"dialog\">\n726|            <h2>What this means</h2>\n727|            <p>{DM_INFO[dmPending]}</p>\n728|            <button className=\"primary\" data-agency=\"dm.info_continue\" onClick={() => commitDm(dmPending)}>\n729|              Continue\n730|            </button>\n731|          </div>\n732|        </div>\n733|      )}\n734|\n735|      {stConfirm && (\n736|        <div className=\"scrim\">\n737|          <div className=\"sheet\" role=\"dialog\">\n738|            <h2>Set a daily limit?</h2>\n739|            <p>Circle will pause your feed when time runs out, including during video calls.</p>\n740|            <button\n741|              className=\"primary\"\n742|              data-agency=\"st.keep_unlimited\"\n743|              onClick={() => {\n744|                setStConfirm(null);\n745|                setStPending(null);\n746|              }}\n747|            >\n748|              Keep unlimited\n749|            </button>\n750|            <button className=\"link\" data-agency=\"st.confirm_limit\" onClick={stConfirm}>\n751|              Set limit anyway\n752|            </button>\n753|          </div>\n754|        </div>\n755|      )}\n756|\n757|      {subRetain && (\n758|        <div className=\"scrim\">\n759|          <div className=\"sheet\" role=\"dialog\">\n760|            <h2>Stay for half price?</h2>\n761|            <p>Keep Circle+ with 50% off for the next 2 months.</p>\n762|            <button className=\"primary\" data-agency=\"sub.keep\" onClick={() => setSubRetain(false)}>\n763|              Keep Circle+\n764|            </button>\n765|            <button className=\"link\" data-agency=\"sub.confirm_cancel\" onClick={confirmCancel}>\n766|              Cancel anyway\n767|            </button>\n768|          </div>\n769|        </div>\n770|      )}\n771|    </div>\n772|  );\n773|}\n774|\n775|function LocationOptions({ current, onSave }: { current: Mode; onSave: (m: Mode) => void }) {\n776|  const [mode, setMode] = useState<Mode>(current === \"off\" ? \"precise\" : current);\n777|  const opt = (m: Mode, label: string, tag: string) => (\n778|    <label className=\"row radio-row\">\n779|      <input type=\"radio\" name=\"loc\" data-agency={tag} checked={mode === m} onChange={() => setMode(m)} />\n780|      <span>{label}</span>\n781|    </label>\n782|  );\n783|  return (\n784|    <>\n785|      <List>\n786|        {opt(\"precise\", \"Precise location (recommended)\", \"location.opt_precise\")}\n787|        {opt(\"approximate\", \"Approximate location\", \"location.opt_approximate\")}\n788|        {opt(\"off\", \"Don't use my location\", \"location.decline\")}\n789|      </List>\n790|      <div className=\"footer\">\n791|        <button className=\"primary\" data-agency=\"location.save\" onClick={() => onSave(mode)}>\n792|          Save\n793|        </button>\n794|      </div>\n795|    </>\n796|  );\n797|}\n798|\n799|function List({ children }: { children: React.ReactNode }) {\n800|  return <div className=\"list\">{children}</div>;\n801|}\n802|\n803|function Row({ label, detail, tag, onClick }: { label: string; detail?: string; tag?: string; onClick?: () => void }) {\n804|  return (\n805|    <button className=\"row\" data-agency={tag} onClick={onClick}>\n806|      <span>\n807|        {label}\n808|        {detail && <small>{detail}</small>}\n809|      </span>\n810|      <span className=\"chev\">›</span>\n811|    </button>\n812|  );\n813|}\n814|\n815|function Option({\n816|  title,\n817|  sub,\n818|  tag,\n819|  selected,\n820|  onPick,\n821|}: {\n822|  title: string;\n823|  sub: string;\n824|  tag: string;\n825|  selected: boolean;\n826|  onPick: () => void;\n827|}) {\n828|  return (\n829|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n830|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n831|      <span>\n832|        {title}\n833|        <small>{sub}</small>\n834|      </span>\n835|    </button>\n836|  );\n837|}\n838|\n839|const POSTS = [\n840|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n841|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n842|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n843|];\n844|\n845|function Feed({ posts }: { posts: typeof POSTS }) {\n846|  return (\n847|    <div className=\"feed\">\n848|      {posts.map((p) => (\n849|        <article key={p.who} className=\"post\">\n850|          <div className=\"who\">\n851|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n852|            {p.who}\n853|          </div>\n854|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n855|          <p>{p.text}</p>\n856|        </article>\n857|      ))}\n858|    </div>\n859|  );\n860|}\n861|","final_result":true}}}
