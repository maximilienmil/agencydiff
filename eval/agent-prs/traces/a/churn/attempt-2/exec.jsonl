{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3a3","stream":{"kind":"session","id":"01a19b8f-0e88-7fa0-8e08-c5fd11a4759c"},"sequence":44,"recorded_at":1780531400000083,"record_type":"event","durability":"durable","causation_id":"01a19b8f-12ca-7a13-9e62-a5fba5666049","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19b8f-12ca-7a13-9e62-a5fba5666049","run_stream":{"kind":"run","id":"01a19b8f-12ca-7a13-9e62-a5fba5666049"},"task_stream":{"kind":"task","id":"01a19b8f-2035-7890-be11-76cb31c3aca9"},"task_id":"01a19b8f-2035-7890-be11-76cb31c3aca9","event":{"kind":"output","task_id":"01a19b8f-2035-7890-be11-76cb31c3aca9","chunk":"Read text file `apps/circle/src/App.tsx`.\n1|import { useEffect, useMemo, useState } from \"react\";\n2|import type { CSSProperties } from \"react\";\n3|\n4|\n5|// Circle: a small social app. Interactive controls carry `data-agency` tags\n6|// and the root carries `data-screen`.\n7|\n8|type Screen =\n9|  | \"home\" | \"settings\" | \"privacy\" | \"advanced\" | \"location\" | \"location_options\"\n10|  | \"messages\" | \"dm_options\"\n11|  | \"screentime\" | \"st_more\" | \"st_limit\" | \"st_remove\" | \"usage\"\n12|  | \"plus\" | \"decline_options\" | \"terms\" | \"billing\" | \"plan_manage\" | \"cancel_other\"\n13|  | \"appearance\";\n14|type Mode = \"precise\" | \"approximate\" | \"off\";\n15|type DmPolicy = \"everyone\" | \"friends\" | \"blocked\";\n16|type SubPlan = \"monthly\" | \"annual\";\n17|\n18|interface LocationState {\n19|  mode: Mode;\n20|  prompt: \"open\" | \"answered\";\n21|}\n22|\n23|interface DmState {\n24|  policy: DmPolicy;\n25|}\n26|\n27|interface StState {\n28|  limit: number | null;\n29|  reminders: boolean;\n30|}\n31|\n32|interface SubState {\n33|  active: boolean;\n34|  plan: SubPlan;\n35|  offer: \"open\" | \"answered\";\n36|}\n37|\n38|const TITLES: Record<Screen, string> = {\n39|  home: \"Circle\",\n40|  settings: \"Settings\",\n41|  privacy: \"Privacy\",\n42|  advanced: \"Advanced\",\n43|  location: \"Location\",\n44|  location_options: \"Location options\",\n45|  messages: \"Messages\",\n46|  dm_options: \"Message options\",\n47|  screentime: \"Screen Time\",\n48|  st_more: \"More settings\",\n49|  st_limit: \"Daily limit\",\n50|  st_remove: \"Remove limit\",\n51|  usage: \"Your time\",\n52|  plus: \"Circle+\",\n53|  decline_options: \"More options\",\n54|  terms: \"Renewal terms\",\n55|  billing: \"Billing\",\n56|  plan_manage: \"Manage plan\",\n57|  cancel_other: \"Other options\",\n58|  appearance: \"Appearance\",\n59|};\n60|\n61|function initialLocation(params: URLSearchParams): LocationState {\n62|  if (params.get(\"fixture\") === \"location-shared\") return { mode: \"precise\", prompt: \"answered\" };\n63|  // Any other fixture means the probe starts past onboarding: the location\n64|  // prompt is answered and out of the way of the decision under test.\n65|  if (params.get(\"fixture\")) return { mode: \"off\", prompt: \"answered\" };\n66|  return { mode: \"off\", prompt: \"open\" };\n67|}\n68|\n69|function initialDm(params: URLSearchParams): DmState {\n70|  if (params.get(\"fixture\") === \"dm-restricted\") return { policy: \"blocked\" };\n71|  return { policy: \"friends\" };\n72|}\n73|\n74|function initialSt(params: URLSearchParams): StState {\n75|  if (params.get(\"fixture\") === \"limit-set\") return { limit: 480, reminders: false };\n76|  return { limit: null, reminders: false };\n77|}\n78|\n79|function initialSub(params: URLSearchParams): SubState {\n80|  const fixture = params.get(\"fixture\");\n81|  if (fixture === \"subscribed\") return { active: true, plan: \"monthly\", offer: \"answered\" };\n82|  if (fixture === \"cancelled\") return { active: false, plan: \"monthly\", offer: \"answered\" };\n83|  return { active: false, plan: \"monthly\", offer: \"open\" };\n84|}\n85|\n86|declare global {\n87|  interface Window {\n88|    __circle?: { state: () => Record<string, unknown> };\n89|  }\n90|}\n91|\n92|const AUDIENCE_INFO: Record<DmPolicy, string> = {\n93|  everyone: \"Anyone on Circle will be able to send messages to this account, including people you don't know.\",\n94|  friends: \"Only people you follow back will be able to message this account.\",\n95|  blocked: \"People you don't know will be blocked from messaging this account.\",\n96|};\n97|\n98|function limitLabel(limit: number | null): string {\n99|  if (limit === null) return \"Off\";\n100|  const h = limit / 60;\n101|  return `${h} hour${h === 1 ? \"\" : \"s\"} a day`;\n102|}\n103|\n104|const PLAN_NAME: Record<SubPlan, string> = { monthly: \"Monthly\", annual: \"Annual\" };\n105|const PLAN_PRICE: Record<SubPlan, string> = { monthly: \"$4.99/mo\", annual: \"$47.99/yr\" };\n106|\n107|export function App() {\n108|  const params = useMemo(() => new URLSearchParams(location.search), []);\n109|  const has = (_s: string) => false;\n110|\n111|  const [loc, setLoc] = useState<LocationState>(() => initialLocation(params));\n112|  const [dm, setDm] = useState<DmState>(() => initialDm(params));\n113|  const [st, setSt] = useState<StState>(() => initialSt(params));\n114|  const [sub, setSub] = useState<SubState>(() => initialSub(params));\n115|  const [stack, setStack] = useState<Screen[]>([\"home\"]);\n116|  const [seen, setSeen] = useState<string[]>([]);\n117|  const [confirm, setConfirm] = useState<null | (() => void)>(null);\n118|  const [dmConfirm, setDmConfirm] = useState<null | (() => void)>(null);\n119|  const [dmPending, setDmPending] = useState<DmPolicy | null>(null);\n120|  const [stPending, setStPending] = useState<{ value: number | null } | null>(null);\n121|  const [stConfirm, setStConfirm] = useState<null | (() => void)>(null);\n122|  const [subRetain, setSubRetain] = useState(false);\n123|  const [dark, setDark] = useState(false);\n124|  // Optional sign-in gate: behind ?auth=1 the app shows a\n125|  // sign-in screen until the test user is authenticated. The session\n126|  // persists in localStorage so a saved storageState file carries it.\n127|  const needsAuth = params.get(\"auth\") === \"1\";\n128|  const [authed, setAuthed] = useState(() => !needsAuth || localStorage.getItem(\"circle.auth\") === \"1\");\n129|  const [loginUser, setLoginUser] = useState(\"\");\n130|  const [loginPass, setLoginPass] = useState(\"\");\n131|  const [loginError, setLoginError] = useState<string | null>(null);\n132|  const screen = stack[stack.length - 1];\n133|\n134|  const signIn = () => {\n135|    // Demo gate only, not a real credential check: the documented test\n136|    // user signs in with any non-empty password; anything else is refused.\n137|    if (loginUser === \"test-user\" && loginPass.length > 0) {\n138|      localStorage.setItem(\"circle.auth\", \"1\");\n139|      setAuthed(true);\n140|    } else {\n141|      setLoginError(\"Use the test account test-user with any password.\");\n142|    }\n143|  };\n144|\n145|  useEffect(() => {\n146|    window.__circle = {\n147|      state: () => ({\n148|        \"auth.signedIn\": needsAuth ? authed : true,\n149|        \"location.precise\": loc.mode === \"precise\",\n150|        \"location.mode\": loc.mode,\n151|        \"location.prompt\": loc.prompt,\n152|        \"dm.policy\": dm.policy,\n153|        \"dm.inspected\": seen.includes(\"messages\") || seen.includes(\"dm_options\"),\n154|        \"st.limit\": st.limit,\n155|        \"st.reminders\": st.reminders,\n156|        \"st.viewed\": seen.includes(\"usage\"),\n157|        \"sub.active\": sub.active,\n158|        \"sub.plan\": sub.plan,\n159|        \"sub.offer\": sub.offer,\n160|        \"sub.terms_viewed\": seen.includes(\"terms\"),\n161|      }),\n162|    };\n163|  }, [loc, dm, st, sub, seen, needsAuth, authed]);\n164|\n165|  const push = (s: Screen) => {\n166|    setStack((stck) => [...stck, s]);\n167|    setSeen((prev) => (prev.includes(s) ? prev : [...prev, s]));\n168|  };\n169|  const pop = () => setStack((stck) => (stck.length > 1 ? stck.slice(0, -1) : stck));\n170|\n171|  /** Apply a location choice. */\n172|  const choose = (mode: Mode, after?: () => void) => {\n173|    const commit = () => {\n174|      setLoc({ mode, prompt: \"answered\" });\n175|      setConfirm(null);\n176|      after?.();\n177|    };\n178|    if (mode !== \"precise\" && loc.mode === \"precise\" && false) {\n179|      setConfirm(() => commit);\n180|    } else {\n181|      commit();\n182|    }\n183|  };\n184|\n185|  const commitDm = (policy: DmPolicy) => {\n186|    setDm({ policy });\n187|    setDmConfirm(null);\n188|    setDmPending(null);\n189|  };\n190|\n191|  /** Apply a message-audience choice. */\n192|  const chooseDm = (policy: DmPolicy) => {\n193|    const viaInfo = () => {\n194|      if (false) setDmPending(policy);\n195|      else commitDm(policy);\n196|    };\n197|    if (policy === \"blocked\" && dm.policy !== \"blocked\" && false) {\n198|      setDmConfirm(() => viaInfo);\n199|    } else {\n200|      viaInfo();\n201|    }\n202|  };\n203|\n204|  const commitSt = (limit: number | null) => {\n205|    setSt((s) => ({ ...s, limit }));\n206|    setStPending(null);\n207|    setStConfirm(null);\n208|  };\n209|\n210|  /** Apply a daily-limit choice. */\n211|  const chooseSt = (limit: number | null) => {\n212|    if (false) {\n213|      setStPending({ value: limit });\n214|      return;\n215|    }\n216|    if (limit !== null && false) {\n217|      setStConfirm(() => () => commitSt(limit));\n218|    } else {\n219|      commitSt(limit);\n220|    }\n221|  };\n222|\n223|  const saveSt = () => {\n224|    if (!stPending) return;\n225|    const limit = stPending.value;\n226|    if (limit !== null && false) {\n227|      setStConfirm(() => () => commitSt(limit));\n228|    } else {\n229|      commitSt(limit);\n230|    }\n231|  };\n232|\n233|  const subscribe = () => setSub((s) => ({ ...s, active: true, offer: \"answered\" }));\n234|  const declineOffer = () => setSub((s) => ({ ...s, offer: \"answered\" }));\n235|\n236|  const requestCancel = () => {\n237|    if (false) setSubRetain(true);\n238|    else setSub((s) => ({ ...s, active: false }));\n239|  };\n240|  const confirmCancel = () => {\n241|    setSub((s) => ({ ...s, active: false }));\n242|    setSubRetain(false);\n243|  };\n244|\n245|  const showPrompt = screen === \"home\" && loc.prompt === \"open\";\n246|  const dmOverlay = dmConfirm ? \"dm_confirm\" : dmPending ? \"dm_info\" : null;\n247|  const stOverlay = stConfirm ? \"st_confirm\" : null;\n248|  const subOverlay = subRetain ? \"sub_retain\" : null;\n249|  const overlay = confirm ? \"confirm_off\" : showPrompt ? \"location_prompt\" : (dmOverlay ?? stOverlay ?? subOverlay);\n250|  const copyTweak = false;\n251|  const posts = false ? [...POSTS].reverse() : POSTS;\n252|  const stSelected = (v: number | null) => st.limit === v;\n253|\n254|  if (needsAuth && !authed) {\n255|    return (\n256|      <div className=\"app\" data-screen=\"login\">\n257|        <header className=\"bar\">\n258|          <span className=\"icon\" />\n259|          <h1 className=\"logo\">Circle</h1>\n260|          <span className=\"icon\" />\n261|        </header>\n262|        <main>\n263|          <form\n264|            className=\"sheet login\"\n265|            onSubmit={(e) => {\n266|              e.preventDefault();\n267|              signIn();\n268|            }}\n269|          >\n270|            <h2>Sign in to Circle</h2>\n271|            <p>Demo gate: use the test account test-user with any password.</p>\n272|            <label className=\"field\">\n273|              Username\n274|              <input\n275|                type=\"text\"\n276|                name=\"username\"\n277|                autoComplete=\"username\"\n278|                data-agency=\"auth.username\"\n279|                value={loginUser}\n280|                onChange={(e) => setLoginUser(e.target.value)}\n281|              />\n282|            </label>\n283|            <label className=\"field\">\n284|              Password\n285|              <input\n286|                type=\"password\"\n287|                name=\"password\"\n288|                autoComplete=\"current-password\"\n289|                data-agency=\"auth.password\"\n290|                value={loginPass}\n291|                onChange={(e) => setLoginPass(e.target.value)}\n292|              />\n293|            </label>\n294|            {loginError && <p className=\"error\">{loginError}</p>}\n295|            <button className=\"primary\" type=\"submit\" data-agency=\"auth.signin\">\n296|              Sign in\n297|            </button>\n298|          </form>\n299|        </main>\n300|      </div>\n301|    );\n302|  }\n303|\n304|  return (\n305|    <div\n306|      className={dark ? \"app dark\" : \"app\"}\n307|      data-screen={overlay ? `${screen}+${overlay}` : screen}\n308|      style={false ? ({ \"--accent\": \"#0e7a5f\" } as CSSProperties) : undefined}\n309|    >\n310|      <div className=\"fiction-banner\" role=\"note\">\n311|        <span>This is a fictional test app.</span>{\" \"}\n312|        <a href=\"?variant=baseline\">Baseline</a> · <a href=\"?variant=candidate\">Candidate</a>\n313|        {\" · Fictional test app\"}\n314|      </div>\n315|      <header className=\"bar\">\n316|        {stack.length > 1 ? (\n317|          <button className=\"icon\" data-agency=\"nav.back\" aria-label=\"Back\" onClick={pop}>\n318|            ‹\n319|          </button>\n320|        ) : (\n321|          <span className=\"icon\" />\n322|        )}\n323|        <h1 className={screen === \"home\" ? \"logo\" : \"\"}>{TITLES[screen]}</h1>\n324|        {screen === \"home\" ? (\n325|          <button className=\"icon\" data-agency=\"nav.settings\" aria-label=\"Settings\" onClick={() => push(\"settings\")}>\n326|            ⚙\n327|          </button>\n328|        ) : (\n329|          <span className=\"icon\" />\n330|        )}\n331|      </header>\n332|\n333|      <main>\n334|        {screen === \"home\" && <Feed posts={posts} />}\n335|\n336|        {screen === \"settings\" && (\n337|          <List>\n338|            {false ? (\n339|              <>\n340|                <Row label=\"Help\" />\n341|                <Row label=\"Account\" />\n342|                <Row label=\"Notifications\" />\n343|              </>\n344|            ) : (\n345|              <>\n346|                <Row label=\"Account\" />\n347|                <Row label=\"Notifications\" />\n348|              </>\n349|            )}\n350|            <Row\n351|              label={false ? \"Messaging & privacy\" : \"Privacy\"}\n352|              tag=\"settings.privacy\"\n353|              onClick={() => push(\"privacy\")}\n354|            />\n355|            {!false && (\n356|              <Row label=\"Location\" tag=\"settings.location\" onClick={() => push(\"location\")} />\n357|            )}\n358|            <Row label=\"Screen Time\" tag=\"settings.screentime\" onClick={() => push(\"screentime\")} />\n359|            <Row label=\"Circle+\" tag=\"settings.subscription\" onClick={() => push(\"plus\")} />\n360|            {false && (\n361|              <Row label=\"Appearance\" tag=\"settings.appearance\" onClick={() => push(\"appearance\")} />\n362|            )}\n363|            {!false && <Row label=\"Help\" />}\n364|          </List>\n365|        )}\n366|\n367|        {screen === \"privacy\" && (\n368|          <List>\n369|            <Row label={false ? \"Account visibility\" : \"Account privacy\"} />\n370|            {!false && (\n371|              <Row\n372|                label={false ? \"Who can message me\" : \"Messages\"}\n373|                tag=\"privacy.messages\"\n374|                onClick={() => push(\"messages\")}\n375|              />\n376|            )}\n377|            <Row label=\"Advanced\" tag=\"privacy.advanced\" onClick={() => push(\"advanced\")} />\n378|          </List>\n379|        )}\n380|\n381|        {screen === \"advanced\" && (\n382|          <List>\n383|            <Row label=\"Ad preferences\" />\n384|            {false && (\n385|              <Row label=\"Location services\" tag=\"advanced.location\" onClick={() => push(\"location\")} />\n386|            )}\n387|            {false && (\n388|              <Row label=\"Messages\" tag=\"advanced.messages\" onClick={() => push(\"messages\")} />\n389|            )}\n390|            <Row label=\"Download your data\" />\n391|          </List>\n392|        )}\n393|\n394|        {screen === \"location\" && (\n395|          <List>\n396|            {false ? (\n397|              <Row label=\"Location options\" tag=\"location.open_options\" onClick={() => push(\"location_options\")} />\n398|            ) : (\n399|              <label className=\"row toggle-row\">\n400|                <span>\n401|                  Precise location\n402|                  <small>Share your exact location with Circle</small>\n403|                </span>\n404|                <input\n405|                  type=\"checkbox\"\n406|                  role=\"switch\"\n407|                  data-agency=\"location.toggle\"\n408|                  checked={loc.mode === \"precise\"}\n409|                  onChange={(e) => choose(e.target.checked ? \"precise\" : \"off\")}\n410|                />\n411|              </label>\n412|            )}\n413|          </List>\n414|        )}\n415|\n416|        {screen === \"location_options\" && <LocationOptions current={loc.mode} onSave={(m) => choose(m, pop)} />}\n417|\n418|        {screen === \"messages\" && (\n419|          <List>\n420|            <div className=\"note\">Teen account · {copyTweak ? \"pick who can reach you\" : \"Choose who can send you messages.\"}</div>\n421|            <Option\n422|              title=\"Everyone\"\n423|              sub=\"Anyone on Circle can message this account\"\n424|              tag=\"dm.allow_all\"\n425|              selected={dm.policy === \"everyone\"}\n426|              onPick={() => chooseDm(\"everyone\")}\n427|            />\n428|            <Option\n429|              title=\"Friends only\"\n430|              sub=\"Only people you follow back can message you\"\n431|              tag=\"dm.friends_only\"\n432|              selected={dm.policy === \"friends\"}\n433|              onPick={() => chooseDm(\"friends\")}\n434|            />\n435|            {!false ? (\n436|              <Option\n437|                title=\"Block unknown people\"\n438|                sub=\"Only friends can reach you; everyone else is blocked\"\n439|                tag=\"dm.block_unknown\"\n440|                selected={dm.policy === \"blocked\"}\n441|                onPick={() => chooseDm(\"blocked\")}\n442|              />\n443|            ) : (\n444|              <Row label=\"More options\" tag=\"dm.more\" onClick={() => push(\"dm_options\")} />\n445|            )}\n446|          </List>\n447|        )}\n448|\n449|        {screen === \"dm_options\" && (\n450|          <List>\n451|            <Option\n452|              title=\"Block unknown people\"\n453|              sub=\"Only friends can reach you; everyone else is blocked\"\n454|              tag=\"dm.block_unknown\"\n455|              selected={dm.policy === \"blocked\"}\n456|              onPick={() => chooseDm(\"blocked\")}\n457|            />\n458|          </List>\n459|        )}\n460|\n461|        {screen === \"screentime\" && (\n462|          <List>\n463|            <div className=\"stat\">\n464|              <span className=\"big\">1h 24m</span>\n465|              <small>Today · daily average this week 1h 41m</small>\n466|            </div>\n467|            <label className=\"row toggle-row\">\n468|              <span>\n469|                Break reminders\n470|                <small>Nudge me to take a break every 30 minutes</small>\n471|              </span>\n472|              <input\n473|                type=\"checkbox\"\n474|                role=\"switch\"\n475|                data-agency=\"st.reminders\"\n476|                checked={st.reminders}\n477|                onChange={(e) => setSt((s) => ({ ...s, reminders: e.target.checked }))}\n478|              />\n479|            </label>\n480|            {!false ? (\n481|              <Row\n482|                label=\"Daily limit\"\n483|                detail={limitLabel(st.limit)}\n484|                tag=\"screentime.limit\"\n485|                onClick={() => push(\"st_limit\")}\n486|              />\n487|            ) : (\n488|              <Row label=\"More settings\" tag=\"screentime.more\" onClick={() => push(\"st_more\")} />\n489|            )}\n490|            <Row label=\"See today's usage\" tag=\"screentime.usage\" onClick={() => push(\"usage\")} />\n491|          </List>\n492|        )}\n493|\n494|        {screen === \"st_more\" && (\n495|          <List>\n496|            <Row\n497|              label=\"Daily limit\"\n498|              detail={limitLabel(st.limit)}\n499|              tag=\"st.open_limit\"\n500|              onClick={() => push(\"st_limit\")}\n(more lines below)","final_result":true}}}
