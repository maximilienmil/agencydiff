lick={stConfirm}>\n821|              Set limit anyway\n822|            </button>\n823|          </div>\n824|        </div>\n825|      )}\n826|\n827|      {subRetain && (\n828|        <div className=\"scrim\">\n829|          <div className=\"sheet\" role=\"dialog\">\n830|            <h2>Stay for half price?</h2>\n831|            <p>Keep Circle+ with 50% off for the next 2 months.</p>\n832|            <button className=\"primary\" data-agency=\"sub.keep\" onClick={() => setSubRetain(false)}>\n833|              Keep Circle+\n834|            </button>\n835|            <button className=\"link\" data-agency=\"sub.confirm_cancel\" onClick={confirmCancel}>\n836|              Cancel anyway\n837|            </button>\n838|          </div>\n839|        </div>\n840|      )}\n841|    </div>\n842|  );\n843|}\n844|\n845|function LocationOptions({ current, onSave }: { current: Mode; onSave: (m: Mode) => void }) {\n846|  const [mode, setMode] = useState<Mode>(current === \"off\" ? \"precise\" : current);\n847|  const opt = (m: Mode, label: string, tag: string) => (\n848|    <label className=\"row radio-row\">\n849|      <input type=\"radio\" name=\"loc\" data-agency={tag} checked={mode === m} onChange={() => setMode(m)} />\n850|      <span>{label}</span>\n851|    </label>\n852|  );\n853|  return (\n854|    <>\n855|      <List>\n856|        {opt(\"precise\", \"Precise location (recommended)\", \"location.opt_precise\")}\n857|        {opt(\"approximate\", \"Approximate location\", \"location.opt_approximate\")}\n858|        {opt(\"off\", \"Don't use my location\", \"location.decline\")}\n859|      </List>\n860|      <div className=\"footer\">\n861|        <button className=\"primary\" data-agency=\"location.save\" onClick={() => onSave(mode)}>\n862|          Save\n863|        </button>\n864|      </div>\n865|    </>\n866|  );\n867|}\n868|\n869|function List({ children }: { children: React.ReactNode }) {\n870|  return <div className=\"list\">{children}</div>;\n871|}\n872|\n873|functio