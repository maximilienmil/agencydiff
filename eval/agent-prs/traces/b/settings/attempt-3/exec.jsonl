        <button className=\"link\" data-agency=\"sub.decline\" onClick={declineOffer}>\n629|                      {copyTweak ? \"Maybe later\" : \"Not now\"}\n630|                    </button>\n631|                  ) : (\n632|                    <button className=\"link\" data-agency=\"sub.more\" onClick={() => push(\"decline_options\")}>\n633|                      More options\n634|                    </button>\n635|                  )}\n636|                </div>\n637|                <List>\n638|                  {!false ? (\n639|                    <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n640|                  ) : (\n641|                    <div className=\"note\">Full terms are shown after checkout.</div>\n642|                  )}\n643|                </List>\n644|              </>\n645|            ) : (\n646|              <List>\n647|                <Row label=\"Manage subscription\" tag=\"sub.manage\" onClick={() => push(\"billing\")} />\n648|                <Row label=\"Renewal terms\" tag=\"sub.terms\" onClick={() => push(\"terms\")} />\n649|              </List>\n650|            )}\n651|          </>\n652|        )}\n653|\n654|        {screen === \"decline_options\" && (\n655|          <>\n656|            <div className=\"note\">No problem. Circle stays free, and you can join Circle+ anytime.</div>\n657|            <div className=\"footer\">\n658|              <button\n659|                className=\"link\"\n660|                data-agency=\"sub.decline\"\n661|                onClick={() => {\n662|                  declineOffer();\n663|                  pop();\n664|                }}\n665|              >\n666|                Not now\n667|              </button>\n668|            </div>\n669|          </>\n670|        )}\n671|\n672|        {screen === \"terms\" && (\n673|          <List>\n674|            <div className=\"note\">\n675|              Circle+ {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}. Your plan renews automatically each{\" \"}\n676|              {sub.plan === \"monthly\" ? \"month\" : \"year\"} until you cancel. Cancel anytime in Settings · Billing;\n677|              you keep Circle+ until the end of the paid period.\n678|            </div>\n679|          </List>\n680|        )}\n681|\n682|        {screen === \"billing\" && (\n683|          <List>\n684|            <div className=\"note\">\n685|              Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]}\n686|            </div>\n687|            {false ? (\n688|              <Row label=\"Manage plan\" tag=\"sub.billing_manage\" onClick={() => push(\"plan_manage\")} />\n689|            ) : (\n690|              <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n691|            )}\n692|          </List>\n693|        )}\n694|\n695|        {screen === \"plan_manage\" && (\n696|          <List>\n697|            <Row label=\"Change plan\" />\n698|            <Row label=\"Pause plan\" />\n699|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n700|          </List>\n701|        )}\n702|\n703|        {screen === \"cancel_other\" && (\n704|          <List>\n705|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n706|          </List>\n707|        )}\n708|\n709|        {screen === \"appearance\" && (\n710|          <List>\n711|            <Option\n712|              title=\"Light\"\n713|              sub=\"Default bright theme\"\n714|              tag=\"appearance.light\"\n715|              selected={!dark}\n716|              onPick={() => setDark(false)}\n717|            />\n718|            <Option\n719|              title=\"Dark\"\n720|              sub=\"Dim the interface in the evening\"\n721|              tag=\"appearance.dark\"\n722|              selected={dark}\n723|              onPick={() => setDark(true)}\n724|            />\n725|          </List>\n726|        )}\n727|      </main>\n728|\n729|      {showPrompt && !confirm && (\n730|        <div className=\"scrim\">\n731|          <div className=\"sheet\" role=\"dialog\">\n732|            {false ? (\n733|              <>\n734|                <div className=\"pin\">📍</div>\n735|                <h2>Find friends and events near you</h2>\n736|                <p>Circle works best with your precise location.</p>\n737|                <button className=\"primary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n738|                  Continue\n739|                </button>\n740|                <button className=\"link\" data-agency=\"location.more\" onClick={() => push(\"location_options\")}>\n741|                  More options\n742|                </button>\n743|              </>\n744|            ) : (\n745|              <>\n746|                <div className=\"pin\">📍</div>\n747|                <h2>{copyTweak ? \"Let Circle know where you are?\" : \"Allow Circle to use your precise location?\"}</h2>\n748|                <p>Used to show friends and events near you. You can change this anytime in Settings.</p>\n749|                <div className=\"pair\">\n750|                  <button className=\"secondary\" data-agency=\"location.decline\" onClick={() => choose(\"off\")}>\n751|                    Not now\n752|                  </button>\n753|                  <button className=\"secondary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n754|                    Allow precise location\n755|                  </button>\n756|                </div>\n757|              </>\n758|            )}\n759|          </div>\n760|        </div>\n761|      )}\n762|\n763|      {confirm && (\n764|        <div className=\"scrim\">\n765|          <div className=\"sheet\" role=\"dialog\">\n766|            <h2>Are you sure?</h2>\n767|            <p>Without precise location you&apos;ll miss friends and events happening near you.</p>\n768|            <button className=\"primary\" data-agency=\"location.keep\" onClick={() => setConfirm(null)}>\n769|              Keep precise location\n770|            </button>\n771|            <button className=\"link\" data-agency=\"location.confirm_off\" onClick={confirm}>\n772|              Turn off anyway\n773|            </button>\n774|          </div>\n775|        </div>\n776|      )}\n777|\n778|      {dmConfirm && (\n779|        <div className=\"scrim\">\n780|          <div className=\"sheet\" role=\"dialog\">\n781|            <h2>Block new message requests?</h2>\n782|            <p>You&apos;ll miss messages from new friends and people trying to reach you.</p>\n783|            <button className=\"primary\" data-agency=\"dm.keep_open\" onClick={() => setDmConfirm(null)}>\n784|              Keep messages open\n785|            </button>\n786|            <button className=\"link\" data-agency=\"dm.confirm_block\" onClick={dmConfirm}>\n787|              Block anyway\n788|            </button>\n789|          </div>\n790|        </div>\n791|      )}\n792|\n793|      {dmPending && (\n794|        <div className=\"scrim\">\n795|          <div className=\"sheet\" role=\"dialog\">\n796|            <h2>What this means</h2>\n797|            <p>{AUDIENCE_INFO[dmPending]}</p>\n798|            <button className=\"primary\" data-agency=\"dm.info_continue\" onClick={() => commitDm(dmPending)}>\n799|              Continue\n800|            </button>\n801|          </div>\n802|        </div>\n803|      )}\n804|\n805|      {stConfirm && (\n806|        <div className=\"scrim\">\n807|          <div className=\"sheet\" role=\"dialog\">\n808|            <h2>Set a daily limit?</h2>\n809|            <p>Circle will pause your feed when time runs out, including during video calls.</p>\n810|            <button\n811|              className=\"primary\"\n812|              data-agency=\"st.keep_unlimited\"\n813|              onClick={() => {\n814|                setStConfirm(null);\n815|                setStPending(null);\n816|              }}\n817|            >\n818|              Keep unlimited\n819|            </button>\n820|            <button className=\"link\" data-agency=\"st.confirm_limit\" onClick={stConfirm}>\n821|              Set limit anyway\n822|            </button>\n823|          </div>\n824|        </div>\n825|      )}\n826|\n827|      {subRetain && (\n828|        <div className=\"scrim\">\n829|          <div className=\"sheet\" role=\"dialog\">\n830|            <h2>Stay for half price?</h2>\n831|            <p>Keep Circle+ with 50% off for the next 2 months.</p>\n832|            <button className=\"primary\" data-agency=\"sub.keep\" onClick={() => setSubRetain(false)}>\n833|              Keep Circle+\n834|            </button>\n835|            <button className=\"link\" data-agency=\"sub.confirm_cancel\" onClick={confirmCancel}>\n836|              Cancel anyway\n837|            </button>\n838|          </div>\n839|        </div>\n840|      )}\n841|    </div>\n842|  );\n843|}\n844|\n845|function LocationOptions({ current, onSave }: { current: Mode; onSave: (m: Mode) => void }) {\n846|  const [mode, setMode] = useState<Mode>(current === \"off\" ? \"precise\" : current);\n847|  const opt = (m: Mode, label: string, tag: string) => (\n848|    <label className=\"row radio-row\">\n849|      <input type=\"radio\" name=\"loc\" data-agency={tag} checked={mode === m} onChange={() => setMode(m)} />\n850|      <span>{label}</span>\n851|    </label>\n852|  );\n853|  return (\n854|    <>\n855|      <List>\n856|        {opt(\"precise\", \"Precise location (recommended)\", \"location.opt_precise\")}\n857|        {opt(\"approximate\", \"Approximate location\", \"location.opt_approximate\")}\n858|        {opt(\"off\", \"Don't use my location\", \"location.decline\")}\n859|      </List>\n860|      <div className=\"footer\">\n861|        <button className=\"primary\" data-agency=\"location.save\" onClick={() => onSave(mode)}>\n862|          Save\n863|        </button>\n864|      </div>\n865|    </>\n866|  );\n867|}\n868|\n869|function List({ children }: { children: React.ReactNode }) {\n870|  return <div className=\"list\">{children}</div>;\n871|}\n872|\n873|function Row({ label, detail, tag, onClick }: { label: string; detail?: string; tag?: string; onClick?: () => void }) {\n874|  return (\n875|    <button className=\"row\" data-agency={tag} onClick={onClick}>\n876|      <span>\n877|        {label}\n878|        {detail && <small>{detail}</small>}\n879|      </span>\n880|      <span className=\"chev\">›</span>\n881|    </button>\n882|  );\n883|}\n884|\n885|function Option({\n886|  title,\n887|  sub,\n888|  tag,\n889|  selected,\n890|  onPick,\n891|}: {\n892|  title: string;\n893|  sub: string;\n894|  tag: string;\n895|  selected: boolean;\n896|  onPick: () => void;\n897|}) {\n898|  return (\n899|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n900|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n901|      <span>\n902|        {title}\n903|        <small>{sub}</small>\n904|      </span>\n905|    </button>\n906|  );\n907|}\n908|\n909|const POSTS = [\n910|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n911|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n912|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n913|];\n914|\n915|function Feed({ posts }: { posts: typeof POSTS }) {\n916|  return (\n917|    <div className=\"feed\">\n918|      {posts.map((p) => (\n919|        <article key={p.who} className=\"post\">\n920|          <div className=\"who\">\n921|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n922|            {p.who}\n923|          </div>\n924|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n925|          <p>{p.text}</p>\n926|        </article>\n927|      ))}\n928|    </div>\n929|  );\n930|}\n931|","final_result":true}