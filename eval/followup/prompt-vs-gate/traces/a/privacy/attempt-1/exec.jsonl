ed after 2 hours\"\n537|                tag=\"st.limit_2h\"\n538|                selected={stSelected(120)}\n539|                onPick={() => chooseSt(120)}\n540|              />\n541|              <Option\n542|                title=\"4 hours a day\"\n543|                sub=\"Pause my feed after 4 hours\"\n544|                tag=\"st.limit_4h\"\n545|                selected={stSelected(240)}\n546|                onPick={() => chooseSt(240)}\n547|              />\n548|            </List>\n549|            {false && (\n550|              <div className=\"footer\">\n551|                <button className=\"primary\" data-agency=\"st.save_limit\" onClick={saveSt}>\n552|                  Save\n553|                </button>\n554|              </div>\n555|            )}\n556|          </>\n557|        )}\n558|\n559|        {screen === \"st_remove\" && (\n560|          <>\n561|            <div className=\"note\">Removing your limit means Circle will no longer pause your feed.</div>\n562|            <div className=\"footer\">\n563|              <button\n564|                className=\"primary\"\n565|                data-agency=\"st.limit_off\"\n566|                onClick={() => {\n567|                  commitSt(null);\n568|                  pop();\n569|                }}\n570|              >\n571|                Remove limit\n572|              </button>\n573|            </div>\n574|          </>\n575|        )}\n576|\n577|        {screen === \"usage\" && (\n578|          <List>\n579|            <div className=\"stat\">\n580|              <span className=\"big\">1h 24m</span>\n581|              <small>Today</small>\n582|            </div>\n583|            <div className=\"stat\">\n584|              <span className=\"big\">11h 47m</span>\n585|              <small>This week</small>\n586|            </div>\n587|            <div className=\"note\">Most time in Feed · evenings after 8pm</div>\n588|          </List>\n589|        )}\n590|\n591|        {screen === \"plus\" && (\n592|          <>\n593|            <div className=\"stat\">\n594|              <span className=\"big\">Circle+</span>\n595|              <small>{copyTweak ? \"More of Circle, fewer interruptions\" : \"Ad-free with early access to new features.\"}</small>\n596|            </div>\n597|            <List>\n598|              {!sub.active ? (\n599|                <>\n600|                  <Option\n601|                    title={`Monthly · ${PLAN_PRICE.monthly}`}\n602|                    sub=\"Renews every month until you cancel\"\n603|                    tag=\"sub.plan_monthly\"\n604|                    selected={sub.plan === \"monthly\"}\n605|                    onPick={() => setSub((s) => ({ ...s, plan: \"monthly\" }))}\n606|                  />\n607|                  <Option\n608|                    title={`Annual · ${PLAN_PRICE.annual}`}\n609|                    sub=\"Renews every year until you cancel\"\n610|                    tag=\"sub.plan_annual\"\n611|                    selected={sub.plan === \"annual\"}\n612|                    onPick={() => setSub((s) => ({ ...s, plan: \"annual\" }))}\n613|                  />\n614|                </>\n615|              ) : (\n616|                <div className=\"note\">\n617|                  Circle+ · {PLAN_NAME[sub.plan]} · {PLAN_PRICE[sub.plan]} · active\n618|                </div>\n619|              )}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
