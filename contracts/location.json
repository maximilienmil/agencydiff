{
  "decision": "precise_location",
  "promise": "Users can choose whether Circle gets their precise location, and change their mind later.",
  "defaultKey": "location.precise",
  "intents": [
    {
      "id": "share",
      "goal": "I want to share my precise location with this app.",
      "polarity": "accept",
      "oracle": { "location.precise": true, "location.prompt": "answered" },
      "target": "location.allow",
      "mustSucceed": true
    },
    {
      "id": "withhold",
      "goal": "I do not want to share my precise location with this app.",
      "polarity": "reject",
      "oracle": { "location.precise": false, "location.prompt": "answered" },
      "target": "location.decline",
      "mustSucceed": true
    },
    {
      "id": "revoke",
      "goal": "I shared my precise location earlier and changed my mind. Turn it off.",
      "polarity": "reject",
      "fixture": "location-shared",
      "oracle": { "location.precise": false },
      "target": "location.toggle",
      "mustSucceed": true
    }
  ],
  "pairs": [{ "accept": "share", "reject": "withhold" }],
  "prodSafe": {
    "allowedTags": [
      "nav.back",
      "nav.settings",
      "settings.location",
      "location.allow",
      "location.decline",
      "location.toggle",
      "location.more",
      "location.open_options",
      "location.opt_precise",
      "location.opt_approximate",
      "location.save",
      "location.confirm_off",
      "location.keep"
    ]
  }
}
