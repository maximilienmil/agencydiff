on_options\")}>\n671|                  More options\n672|                </button>\n673|              </>\n674|            ) : (\n675|              <>\n676|                <div className=\"pin\">📍</div>\n677|                <h2>{copyTweak ? \"Let Circle know where you are?\" : \"Allow Circle to use your precise location?\"}</h2>\n678|                <p>Used to show friends and events near you. You can change this anytime in Settings.</p>\n679|                <div className=\"pair\">\n680|                  <button className=\"secondary\" data-agency=\"location.decline\" onClick={() => choose(\"off\")}>\n681|                    Not now\n682|                  </button>\n683|                  <button className=\"secondary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n684|                    Allow precise location\n685|                  </button>\n686|                </div>\n687|              </>\n688|            )}\n689|          </div>\n690|        </div>\n691|      )}\n692|\n693|      {confirm && (\n694|        <div className=\"scrim\">\n695|          <div className=\"sheet\" role=\"dialog\">\n696|            <h2>Are you sure?</h2>\n697|            <p>Without precise location you&apos;ll miss friends and events happening near you.</p>\n698|            <button className=\"primary\" data-agency=\"location.keep\" onClick={() => setConfirm(null)}>\n699|              Keep precise location\n700|            </button>\n701|            <button className=\"link\" data-agency=\"location.confirm_off\" onClick={confirm}>\n702|              Turn off anyway\n703|            </button>\n704|          </div>\n705|        </div>\n706|      )}\n707|\n708|      {dmConfirm && (\n709|        <div className=\"scrim\">\n710|          <div className=\"sheet\" role=\"dialog\">\n711|            <h2>Block new message requests?</h2>\n712|            <p>You&apos;ll miss messages from new friends and people trying to reach you.</p>\n713|            <button className=\"primary\" data-agency=\"dm.keep_open\" onClick={() => setDmConfirm(null)}>\n714|              Keep messages open\n715|            </button>\n716|            <button className=\"link\" data-agency=\"dm.confirm_block\" onClick={dmConfirm}>\n717|              Block anyway\n718|            </button>\n719|          </div>\n720|        </div>\n721|      )}\n722|\n723|      {dmPending && (\n724|        <div className=\"scrim\">\n725|          <div className=\"sheet\" role=\"dialog\">\n726|            <h2>What this means</h2>\n727|            <p>{DM_INFO[dmPending]}</p>\n728|            <button className=\"primary\" data-agency=\"dm.info_continue\" onClick={() => commitDm(dmPending)}>\n729|              Continue\n730|            </button>\n731|          </div>\n732|        </div>\n733|      )}\n734|\n735|      {stConfirm && (\n736|        <div className=\"scrim\">\n737|          <div className=\"sheet\" role=\"dialog\">\n738|            <h2>Set a daily limit?</h2>\n739|            <p>Circle will pause your feed when time runs out, including during video calls.</p>\n740|            <button\n741|              className=\"primary\"\n742|              data-agency=\"st.keep_unlimited\"\n743|              onClick={() => {\n744|                setStConfirm(null);\n745|                setStPending(null);\n746|              }}\n747|            >\n748|              Keep unlimited\n749|            </button>\n750|            <button className=\"link\" data-agency=\"st.confirm_limit\" onClick={stConfirm}>\n751|              Set limit anyway\n752|            </button>\n753|          </div>\n754|        </div>\n755|      )}\n756|\n757|      {subRetain && (\n758|        <div className=\"scrim\">\n759|          <div className=\"sheet\" role=\"dialog\">\n760|            <h2>Stay for half price?</h2>\n761|            <p>Keep Circle+ with 50% off for the next 2 months.</p>\n762|            <button className=\"primary\" data-agency=\"sub.keep\" onClick={() => setSubRetain(false)}>\n763|              Keep Circle+\n764|            </button>\n765|            <button className=\"link\" data-agency=\"sub.confirm_cancel\" onClick={confirmCancel}>\n766|              Cancel anyway\n767|            </button>\n768|          </div>\n769|        </div>\n770|      )}\n771|    </div>\n772|  );\n773|}\n774|\n775|function LocationOptions({ current, onSave }: { current: Mode; onSave: (m: Mode) => void }) {\n776|  const [mode, setMode] = useState<Mode>(current === \"off\" ? \"precise\" : current);\n777|  const opt = (m: Mode, label: string, tag: string) => (\n778|    <label className=\"row radio-row\">\n779|      <input type=\"radio\" name=\"loc\" data-agency={tag} checked={mode === m} onChange={() => setMode(m)} />\n780|      <span>{label}</span>\n781|    </label>\n782|  );\n783|  return (\n784|    <>\n785|      <List>\n786|        {opt(\"precise\", \"Precise location (recommended)\", \"location.opt_precise\")}\n787|        {opt(\"approximate\", \"Approximate location\", \"location.opt_approximate\")}\n788|        {opt(\"off\", \"Don't use my location\", \"location.decline\")}\n789|      </List>\n790|      <div className=\"footer\">\n791|        <button className=\"primary\" data-agency=\"location.save\" onClick={() => onSave(mode)}>\n792|          Save\n793|        </button>\n794|      </div>\n795|    </>\n796|  );\n797|}\n798|\n799|function List({ children }: { children: React.ReactNode }) {\n800|  return <div className=\"list\">{children}</div>;\n801|}\n802|\n803|function Row({ label, detail, tag, onClick }: { label: string; detail?: string; tag?: string; onClick?: () => void }) {\n804|  return (\n805|    <button className=\"row\" data-agency={tag} onClick={onClick}>\n806|      <span>\n807|        {label}\n808|        {detail && <small>{detail}</small>}\n809|      </span>\n810|      <span className=\"chev\">›</span>\n811|    </button>\n812|  );\n813|}\n814|\n815|function Option({\n816|  title,\n817|  sub,\n818|  tag,\n819|  selected,\n820|  onPick,\n821|}: {\n822|  title: string;\n823|  sub: string;\n824|  tag: string;\n825|  selected: boolean;\n826|  onPick: () => void;\n827|}) {\n828|  return (\n829|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n830|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n831|      <span>\n832|        {title}\n833|        <small>{sub}</small>\n834|      </span>\n835|    </button>\n836|  );\n837|}\n838|\n839|const POSTS = [\n840|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n841|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n842|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n843|];\n844|\n845|function Feed({ posts }: { posts: typeof POSTS }) {\n846|  return (\n847|    <div className=\"feed\">\n848|      {posts.map((p) => (\n849|        <article key={p.who} className=\"post\">\n850|          <div className=\"who\">\n851|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n852|            {p.who}\n853|          </div>\n854|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n855|          <p>{p.text}</p>\n856|        </article>\n857|      ))}\n858|    </div>\n859|  );\n860|}\n861|","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ed","stream":{"kind":"session","id":"01a19ad5-c928-73d3-98f3-6acae7da23d8"},"sequence":81,"recorded_at":1780531400000157,"record_type":"event","durability":"durable","causation_id":"01a19ad5-cdf7-7e91-8f3b-acba438aaa58","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19ad5-cdf7-7e91-8f3b-acba438aaa58","run_stream":{"kind":"run","id":"01a19ad5-cdf7-7e91-8f3b-acba438aaa58"},"call_id":"call_01a19ad5e83a7729af298b1842f662c8","text":"Read text file `apps/circle/src/seeds.ts`.\n1|// Every deliberate agency regression in Circle is a named seed. Baseline runs\n2|// with no seeds, candidate with all of them, and the benchmark can switch each\n3|// one on in isolation (?seeds=DM_HIDE_BLOCK) to measure per-seed recall.\n4|// Ground truth for each seed lives in eval/ground_truth.json.\n5|//\n6|// Seeds prefixed LOC/DM/ST/SUB change the cost, visibility, default or success\n7|// of an intent. Seeds prefixed UI are no-change controls: cosmetic tweaks that\n8|// must not move any intent's numbers, so we can measure false alarms.\n9|\n10|export const SEEDS = {\n11|  /** Prompt offers \"Continue\" + \"More options\"; declining lives one screen deeper. */\n12|  LOC_HIDE_DECLINE: \"Decline hidden behind More options\",\n13|  /** Precise location starts on before the user has chosen anything. */\n14|  LOC_DEFAULT_ON: \"Precise location on by default\",\n15|  /** Turning precise location off asks for confirmation with loss framing. */\n16|  LOC_CONFIRM_SHAME: \"Confirm-shaming dialog on turning location off\",\n17|  /** Location settings move from Settings to Settings > Privacy > Advanced. */\n18|  LOC_BURY_SETTING: \"Location setting buried under Privacy > Advanced\",\n19|  /** Location settings offer an options screen instead of a direct toggle. */\n20|  LOC_NO_DIRECT_TOGGLE: \"Direct location toggle replaced by options screen\",\n21|  /** \"Block unknown people\" hides behind More options on the messages screen. */\n22|  DM_HIDE_BLOCK: \"Block-unknown option hidden behind More options\",\n23|  /** Messaging a teen defaults to open to everyone instead of friends only. */\n24|  DM_DEFAULT_EVERYONE: \"Message audience defaults to everyone\",\n25|  /** Messages move from Privacy to Privacy > Advanced. */\n26|  DM_BURY_MESSAGES: \"Message setting buried under Privacy > Advanced\",\n27|  /** Choosing to block unknown people asks for confirmation with loss framing. */\n28|  DM_CONFIRM_BLOCK: \"Confirm-shaming dialog on blocking unknown messages\",\n29|  /** What each audience option means appears only after choosing, not before. */\n30|  DM_INFO_AFTER_CHOICE: \"Audience explanations shown after commitment\",\n31|  /** Removing a screen-time limit hides behind More options on the limit screen. */\n32|  ST_HIDE_REMOVE: \"Remove-limit hidden behind More options\",\n33|  /** The 1-hour preset disappears; the smallest limit on offer is 2 hours. */\n34|  ST_MIN_LIMIT_2H: \"Smallest daily limit raised to 2 hours\",\n35|  /** Daily limit moves from Screen Time to Screen Time > More settings. */\n36|  ST_BURY_LIMIT: \"Daily limit buried under More settings\",\n37|  /** Setting a daily limit asks for confirmation with loss framing. */\n38|  ST_CONFIRM_LIMIT: \"Confirm-shaming dialog on setting a daily limit\",\n39|  /** Limit presets only select; a separate Save commits the choice. */\n40|  ST_REQUIRE_SAVE: \"Limit choice needs an extra Save tap\",\n41|  /** Declining Circle+ hides behind More options on the offer screen. */\n42|  SUB_HIDE_DECLINE: \"Decline hidden behind More options\",\n43|  /** Cancelling moves from Billing to Billing > Manage plan > Other options. */\n44|  SUB_BURY_CANCEL: \"Cancel buried under Billing > Manage plan > Other\",\n45|  /** The offer preselects the annual plan instead of monthly. */\n46|  SUB_DEFAULT_ANNUAL: \"Circle+ plan defaults to annual\",\n47|  /** Cancelling routes through a retention offer that must be dismissed. */\n48|  SUB_RETENTION_OFFER: \"Retention offer shown before cancelling\",\n49|  /** Price and renewal terms appear only after subscribing, not before. */\n50|  SUB_TERMS_AFTER_CHECKOUT: \"Renewal terms shown after commitment\",\n51|  /** Control: reworded headings and buttons, same layout and tags. */\n52|  UI_COPY_TWEAK: \"Control: copy tweak\",\n53|  /** Control: teal accent instead of blue. */\n54|  UI_ACCENT: \"Control: accent colour\",\n55|  /** Control: settings rows in a different order, same screens and taps. */\n56|  UI_REORDER_SETTINGS: \"Control: settings order\",\n57|  /** Control: feed posts in reverse order. */\n58|  UI_FEED_SHUFFLE: \"Control: feed order\",\n59|  /** Control: reworded privacy rows, same destinations. */\n60|  UI_PRIVACY_COPY: \"Control: privacy copy\",\n61|  /** Control: an extra Appearance row that leads nowhere agency-relevant. */\n62|  UI_EXTRA_ROW: \"Control: extra settings row\",\n63|} as const;\n64|\n65|export type SeedId = keyof typeof SEEDS;\n66|\n67|/** Seeds baked into the build with e.g. `VITE_SEEDS=SUB_HIDE_DECLINE vite build`,\n68| *  so a real pull request can carry a real regression without query flags. */\n69|function bakedSeeds(): Set<SeedId> {\n70|  const raw = import.meta.env?.VITE_SEEDS;\n71|  if (typeof raw !== \"string\" || raw.trim() === \"\") return new Set();\n72|  return new Set(raw.split(\",\").filter((s): s is SeedId => s in SEEDS));\n73|}\n74|\n75|export function activeSeeds(params: URLSearchParams): Set<SeedId> {\n76|  const explicit = params.get(\"seeds\");\n77|  if (explicit !== null) {\n78|    return new Set(explicit.split(\",\").filter((s): s is SeedId => s in SEEDS));\n79|  }\n80|  const seeds =\n81|    params.get(\"variant\") === \"candidate\" ? new Set(Object.keys(SEEDS) as SeedId[]) : new Set<SeedId>();\n82|  for (const s of bakedSeeds()) seeds.add(s);\n83|  return seeds;\n84|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
