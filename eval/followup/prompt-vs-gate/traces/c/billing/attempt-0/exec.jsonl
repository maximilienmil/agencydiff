ages\"\n378|                onClick={() => push(\"messages\")}\n379|              />\n380|            )}\n381|            <Row label=\"Advanced\" tag=\"privacy.advanced\" onClick={() => push(\"advanced\")} />\n382|          </List>\n383|        )}\n384|\n385|        {screen === \"advanced\" && (\n386|          <List>\n387|            <Row label=\"Ad preferences\" />\n388|            {false && (\n389|              <Row label=\"Location services\" tag=\"advanced.location\" onClick={() => push(\"location\")} />\n390|            )}\n391|            {false && (\n392|              <Row label=\"Messages\" tag=\"advanced.messages\" onClick={() => push(\"messages\")} />\n393|            )}\n394|            <Row label=\"Download your data\" />\n395|          </List>\n396|        )}\n397|\n398|        {screen === \"location\" && (\n399|          <List>\n400|            {false ? (\n401|              <Row label=\"Location options\" tag=\"location.open_options\" onClick={() => push(\"location_options\")} />\n402|            ) : (\n403|              <label className=\"row toggle-row\">\n404|                <span>\n405|                  Precise location\n406|                  <small>Share your exact location with Circle</small>\n407|                </span>\n408|                <input\n409|                  type=\"checkbox\"\n410|                  role=\"switch\"\n411|                  data-agency=\"location.toggle\"\n412|                  checked={loc.mode === \"precise\"}\n413|                  onChange={(e) => choose(e.target.checked ? \"precise\" : \"off\")}\n414|                />\n415|              </label>\n416|            )}\n417|          </List>\n418|        )}\n419|\n420|        {screen === \"location_options\" && <LocationOptions current={loc.mode} onSave={(m) => choose(m, pop)} />}\n421|\n422|        {screen === \"messages\" && (\n423|          <List>\n424|            <div className=\"note\">Teen account · {copyTweak ? \"pick who can reach you\" : \"Choose who can send you messages.\"}</div>\n425|            <Option\n426|              title=\"Everyone\"\n427|              sub=\"Anyone on Circle can message this account\"\n428|              tag=\"dm.allow_all\"\n429|              selected={dm.policy === \"everyone\"}\n430|              onPick={() => chooseDm(\"everyone\")}\n431|            />\n432|            <Option\n433|              title=\"Friends only\"\n434|              sub=\"Only people you follow back can message you\"\n435|              tag=\"dm.friends_only\"\n436|              selected={dm.policy === \"friends\"}\n437|              onPick={() => chooseDm(\"friends\")}\n438|            />\n439|            {!false ? (\n440|              <Option\n441|                title=\"Block unknown people\"\n442|                sub=\"Only friends can reach you; everyone else is blocked\"\n443|                tag=\"dm.block_unknown\"\n444|                selected={dm.policy === \"blocked\"}\n445|                onPick={() => chooseDm(\"blocked\")}\n446|              />\n447|            ) : (\n448|              <Row label=\"More options\" tag=\"dm.more\" onClick={() => push(\"dm_options\")} />\n449|            )}\n450|          </List>\n451|        )}\n452|\n453|        {screen === \"dm_options\" && (\n454|          <List>\n455|            <Option\n456|              title=\"Block unknown people\"\n457|              sub=\"Only friends can reach you; everyone else is blocked\"\n458|              tag=\"dm.block_unknown\"\n459|              selected={dm.policy === \"blocked\"}\n460|              onPick={() => chooseDm(\"blocked\")}\n461|            />\n462|          </List>\n463|        )}\n464|\n465|        {screen === \"screentime\" && (\n466|          <List>\n467|            <div className=\"stat\">\n468|              <span className=\"big\">1h 24m</span>\n469|              <small>Today · daily average this week 1h 41m</small>\n470|              <WeekChart />\n471|            </div>\n472|            <label className=\"row toggle-row\">\n473|              <span>\n474|                Break reminders\n475|                <small>Nudge me to take a break every 30 minutes</small>\n476|              </span>\n477|              <input\n478|                type=\"checkbox\"\n479|                role=\"switch\"\n480|                data-agency=\"st.reminders\"\n481|                checked={st.reminders}\n482|                onChange={(e) => setSt((s) => ({ ...s, reminders: e.target.checked }))}\n483|              />\n484|            </label>\n485|            {!false ? (\n486|              <Row\n487|                label=\"Daily limit\"\n488|                detail={limitLabel(st.limit)}\n489|                tag=\"screentime.limit\"\n490|                onClick={() => push(\"st_limit\")}\n491|              />\n492|            ) : (\n493|              <Row label=\"More settings\" tag=\"screentime.more\" onClick={() => push(\"st_more\")} />\n494|            )}\n495|            <Row label=\"See today's usage\" tag=\"screentime.usage\" onClick={() => push(\"usage\")} />\n496|          </List>\n497|        )}\n498|\n499|        {screen === \"st_more\" && (\n500|          <List>\n(more lines below)","final_result":true}}}
