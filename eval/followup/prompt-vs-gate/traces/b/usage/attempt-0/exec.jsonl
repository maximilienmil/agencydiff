); box-shadow: 0 0 0 3px var(--ds-blue-wash); }\n224|.error { color: var(--ds-bad-ink); font-size: 14px; margin: 0; }\n225|\n226|@keyframes circle-fade { from { opacity: 0; } to { opacity: 1; } }\n227|@keyframes circle-rise { from { transform: translateY(24px); opacity: 0.6; } to { transform: none; opacity: 1; } }\n228|/* Motion is for people only: automated browsers get still frames. */\n229|.app:not(.motion) *, .app:not(.motion) *::before, .app:not(.motion) *::after {\n230|  animation: none !important; transition: none !important;\n231|}\n232|@media (prefers-reduced-motion: reduce) {\n233|  *, *::before, *::after { animation: none !important; transition: none !important; }\n234|}\n235|\n236|.app.dark {\n237|  --card: #111820;\n238|  --ink: #e4e6eb;\n239|  --muted: #9aa7b0;\n240|  --line: #223240;\n241|  --ds-surface-2: #1c2b33;\n242|  --ds-surface-3: #243742;\n243|  --ds-line-strong: #2f4452;\n244|  --ds-ink-2: #aeb9c1;\n245|  --ds-blue-wash: #14284a;\n246|}\n247|.app.dark .tone-navy { background: #2f4452; }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
