abel=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n621|            )}\n622|          </List>\n623|        )}\n624|\n625|        {screen === \"plan_manage\" && (\n626|          <List>\n627|            <Row label=\"Change plan\" />\n628|            <Row label=\"Pause plan\" />\n629|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n630|          </List>\n631|        )}\n632|\n633|        {screen === \"cancel_other\" && (\n634|          <List>\n635|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n636|          </List>\n637|        )}\n638|\n639|        {screen === \"appearance\" && (\n640|          <List>\n641|            <Option\n642|              title=\"Light\"\n643|              sub=\"Default bright theme\"\n644|              tag=\"appearance.light\"\n645|              selected={!dark}\n646|              onPick={() => setDark(false)}\n647|            />\n648|            <Option\n649|              title=\"Dark\"\n650|              sub=\"Dim the interface in the evening\"\n651|              tag=\"appearance.dark\"\n652|              selected={dark}\n653|              onPick={() => setDark(true)}\n654|            />\n655|          </List>\n656|        )}\n657|      </main>\n658|\n659|      {showPrompt && !confirm && (\n660|        <div className=\"scrim\">\n661|          <div className=\"sheet\" role=\"dialog\">\n662|            {has(\"LOC_HIDE_DECLINE\") ? (\n663|              <>\n664|                <div className=\"pin\">📍</div>\n665|                <h2>Find friends and events near you</h2>\n666|                <p>Circle works best with your precise location.</p>\n667|                <button className=\"primary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n668|                  Continue\n669|                </button>\n670|                <button className=\"link\" data-agency=\"location.more\" onClick={() => push(\"location_options\")}>\n671|                  More options\n672|                </button>\n673|              </>\n674|            ) : (\n675|              <>\n676|                <div className=\"pin\">📍</div>\n677|                <h2>{copyTweak ? \"Let Circle know where you are?\" : \"Allow Circle to use your precise location?\"}</h2>\n678|                <p>Used to show friends and events near you. You can change this anytime in Settings.</p>\n679|                <div className=\"pair\">\n680|                  <button className=\"secondary\" data-agency=\"location.decline\" onClick={() => choose(\"off\")}>\n681|                    Not now\n682|                  </button>\n683|                  <button className=\"secondary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n684|                    Allow precise location\n685|                  </button>\n686|                </div>\n687|              </>\n688|            )}\n689|          </div>\n690|        </div>\n691|      )}\n692|\n693|      {confirm && (\n694|        <div className=\"scrim\">\n695|          <div className=\"sheet\" role=\"dialog\">\n696|            <h2>Are you sure?</h2>\n697|            <p>Without precise location you&apos;ll miss friends and events happening near you.</p>\n698|            <button className=\"primary\" data-agency=\"location.keep\" onClick={() => setConfirm(null)}>\n699|              Keep precise location\n700|            </button>\n701|            <button className=\"link\" data-agency=\"location.confirm_off\" onClick={confirm}>\n702|              Turn off anyway\n703|            </button>\n704|          </div>\n705|        </div>\n706|      )}\n707|\n708|      {dmConfirm && (\n709|        <div className=\"scrim\">\n710|          <div className=\"sheet\" role=\"dialog\">\n711|            <h2>Block new message requests?</h2>\n712|            <p>You&apos;ll miss messages from new friends and people trying to reach you.</p>\n713|            <button className=\"primar