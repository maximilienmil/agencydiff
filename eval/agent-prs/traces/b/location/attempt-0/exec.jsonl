\n867|}\n868|\n869|function List({ children }: { children: React.ReactNode }) {\n870|  return <div className=\"list\">{children}</div>;\n871|}\n872|\n873|function Row({ label, detail, tag, onClick }: { label: string; detail?: string; tag?: string; onClick?: () => void }) {\n874|  return (\n875|    <button className=\"row\" data-agency={tag} onClick={onClick}>\n876|      <span>\n877|        {label}\n878|        {detail && <small>{detail}</small>}\n879|      </span>\n880|      <span className=\"chev\">›</span>\n881|    </button>\n882|  );\n883|}\n884|\n885|function Option({\n886|  title,\n887|  sub,\n888|  tag,\n889|  selected,\n890|  onPick,\n891|}: {\n892|  title: string;\n893|  sub: string;\n894|  tag: string;\n895|  selected: boolean;\n896|  onPick: () => void;\n897|}) {\n898|  return (\n899|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n900|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n901|      <span>\n902|        {title}\n903|        <small>{sub}</small>\n904|      </span>\n905|    </button>\n906|  );\n907|}\n908|\n909|const POSTS = [\n910|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n911|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n912|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n913|];\n914|\n915|function Feed({ posts }: { posts: typeof POSTS }) {\n916|  return (\n917|    <div className=\"feed\">\n918|      {posts.map((p) => (\n919|        <article key={p.who} className=\"post\">\n920|          <div className=\"who\">\n921|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n922|            {p.who}\n923|          </div>\n924|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n925|          <p>{p.text}</p>\n926|        </article>\n927|      ))}\n928|    </div>\n929|  );\n930|}\n931|","final_result":true}}}
