{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a19baa-53e4-7c31-8760-dc948779801d"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"01a19baa-587a-7a11-b515-9f26abd7994c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19baa-587a-7a11-b515-9f26abd7994c","run_stream":{"kind":"run","id":"01a19baa-587a-7a11-b515-9f26abd7994c"},"task_stream":{"kind":"task","id":"01a19bab-0834-78c3-8fc0-0d744a630d95"},"task_id":"01a19bab-0834-78c3-8fc0-0d744a630d95","event":{"kind":"output","task_id":"01a19bab-0834-78c3-8fc0-0d744a630d95","chunk":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"sed -n '80,220p' \\\"/Users/maximilianmilovidov/.t3/worktrees/agencydiff/t3-3b5e2c8e/packages/runner/src/cli.ts\\\"; echo =====; cat \\\"/Users/maximilianmilovidov/.t3/worktrees/agencydiff/t3-3b5e2c8e/packages/runner/src/judge.ts\\\"; echo =====; sed -n '1,120p' \\\"/Users/maximilianmilovidov/.t3/worktrees/agencydiff/t3-3b5e2c8e/packages/runner/src/benchScore.ts\\\"\",\n  \"description\": \"Read gate scoring logic\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      prodSafe: values[\\\"prod-safe\\\"] === true,\\n      target: values.platform === \\\"android\\\" ? \\\"android\\\" : \\\"web\\\",\\n    });\\n  }\\n  const refPath = path.join(ROOT, \\\"eval\\\", \\\"reference_paths\\\", path.basename(contractPath));\\n  const refs: Record<Variant, Record<string, string[]>> = JSON.parse(await readFile(refPath, \\\"utf8\\\"));\\n  const from = scriptedFrom === \\\"each\\\" ? variant : (scriptedFrom as Variant);\\n  return new ScriptedDriver((intent) => refs[from]?.[intent.id] ?? []);\\n}\\n\\nasync function runOneContract(\\n  contractPath: string,\\n  outDir: string,\\n): Promise<{ contract: AgencyContract; report: AgencyReport; outDir: string }> {\\n  const abs = path.resolve(ROOT, contractPath);\\n  const contract: AgencyContract = JSON.parse(await readFile(abs, \\\"utf8\\\"));\\n  const dir = path.join(outDir, contract.decision);\\n  await mkdir(dir, { recursive: true });\\n\\n  const only = values.intents?.split(\\\",\\\");\\n  const intents = contract.intents.filter((i) => !only || only.includes(i.id));\\n  const repeats = Number(values.repeats);\\n  if (values.platform !== \\\"web\\\" && values.platform !== \\\"android\\\") {\\n    throw new Error(`--platform must be web or android (got ${values.platform})`);\\n  }\\n  const target = {\\n    baseline: values.baseline!,\\n    candidate: values.candidate!,\\n    platform: values.platform as \\\"web\\\" | \\\"android\\\",\\n    serial: values.serial,\\n  };\\n  const traces: Trace[] = [];\\n  if (hub) { await hub.start(); hub.serveTraces(outDir); for (const i of intents) hub.emit({ type: \\\"run_started\\\", runId: path.basename(outDir), decision: contract.decision, intentId: i.id, goal: i.goal, at: new Date().toISOString() }); console.log(`live probes: ${hub.url}/events  (report: #/live?source=live&live=${encodeURIComponent(hub.url)})`); }\\n  const storageState = values[\\\"storage-state\\\"] ? path.resolve(ROOT, values[\\\"storage-state\\\"]) : undefined;\\n  // An explicit CLI flag overrides the target file's auth declaration.\\n  const auth = storageState ?? targetAuth?.storageState;\\n  const prodSafe = values[\\\"prod-safe\\\"] === true\\n    ? { allowedTags: contract.prodSafe?.allowedTags, restore: values[\\\"no-restore\\\"] !== true }\\n    : undefined;\\n\\n  const variants = values.variants!.split(\\\",\\\") as Variant[];\\n  for (const v of variants) {\\n    if (v !== \\\"baseline\\\" && v !== \\\"candidate\\\") throw new Error(`--variants must list baseline,candidate (got ${values.variants})`);\\n  }\\n  for (const variant of variants) {\\n    const driver = await makeDriver(contractPath, variant);\\n    for (const intent of intents) {\\n      for (let repeat = 0; repeat < repeats; repeat++) {\\n        const t = await runProbe({\\n          contract,\\n          intent,\\n          variant,\\n          repeat,\\n          target,\\n          driver,\\n          outDir: dir,\\n          onEvent: hub ? (e) => hub.emit(e) : undefined,\\n          ...(auth ? { auth: { storageState: auth } } : {}),\\n          ...(prodSafe ? { prodSafe } : {}),\\n        });\\n        traces.push(t);\\n        const mark = t.oracle.passed === false ? \\\"✗\\\" : t.oracle.passed ? \\\"✓\\\" : \\\"?\\\";\\n        console.log(\\n          `${mark} ${contract.decision} ${variant.padEnd(9)} ${intent.id.padEnd(12)} #${repeat} ${t.steps.length} steps (${t.stoppedReason})`,\\n        );\\n      }\\n    }\\n  }\\n\\n  const report = diffContract({ ...contract, intents }, traces);\\n  if (hub) for (const f of report.findings) hub.emit({ type: \\\"finding\\\", finding: f, at: new Date().toISOString() });\\n  await writeFile(path.join(dir, \\\"report.json\\\"), JSON.stringify(report, null, 2));\\n  printReport(report);\\n  if (values.export) await exportToReportApp({ contract, report, outDir: dir, target });\\n  return { contract, report, outDir: dir };\\n}\\n\\nfunction printReport(r: AgencyReport) {\\n  console.log(`\\\\n${r.passed ? \\\"PASS\\\" : \\\"FAIL\\\"}  ${r.decision}: ${r.promise}`);\\n  for (const f of r.findings) {\\n    console.log(`  [${f.severity.toUpperCase()}] ${f.title}: ${fmt(f.baseline)} → ${fmt(f.candidate)}`);\\n  }\\n}\\n\\nfunction fmt(v: unknown): string {\\n  return typeof v === \\\"number\\\" && !Number.isInteger(v) ? v.toFixed(2) : String(v);\\n}\\n\\n/** Plain-language PR comment / job summary: one intent table per contract. */\\nfunction renderComment(results: { contract: AgencyContract; report: AgencyReport }[]): string {\\n  const passed = results.every((r) => r.report.passed);\\n  const lines = [\\n    `<!-- ${values.marker} -->`,\\n    `## AgencyDiff ${passed ? \\\"passed\\\" : \\\"found regressions\\\"}`,\\n    \\\"\\\",\\n  ];\\n  if (values[\\\"base-ref\\\"] || values[\\\"head-ref\\\"]) {\\n    lines.push(`Compared \\\\`${values[\\\"base-ref\\\"] ?? \\\"?\\\"}\\\\` (baseline) against \\\\`${values[\\\"head-ref\\\"] ?? \\\"?\\\"}\\\\` (candidate) with the ${values.driver} driver.`);\\n    lines.push(\\\"\\\");\\n  }\\n  for (const { contract, report } of results) {\\n    lines.push(`### ${report.passed ? \\\"PASS\\\" : \\\"FAIL\\\"} — ${contract.decision}: ${contract.promise}`);\\n    lines.push(\\\"\\\");\\n    const possibleHeader = values.driver === \\\"scripted\\\" ? \\\"Baseline path still works\\\" : \\\"Still possible\\\";\\n    lines.push(`| Intent | Steps needed | Visible on first screen | ${possibleHeader} | Severity |`);\\n    lines.push(\\\"| --- | --- | --- | --- | --- |\\\");\\n    for (const intent of contract.intents) {\\n      const agg = (v: Variant) => report.aggregates.find((a) => a.intentId === intent.id && a.variant === v);\\n      const b = agg(\\\"baseline\\\");\\n      const c = agg(\\\"candidate\\\");\\n      const steps = `${b?.actionCount ?? \\\"—\\\"} → ${c?.actionCount ?? \\\"—\\\"}`;\\n      const vis = (a?: { initiallyVisible?: boolean }) =>\\n        a?.initiallyVisible === undefined ? \\\"n/a\\\" : a.initiallyVisible ? \\\"yes\\\" : \\\"no\\\";\\n      const possible = (a?: { successRate: number }) =>\\n        a === undefined ? \\\"n/a\\\" : a.successRate >= 1 ? \\\"yes\\\" : a.successRate <= 0 ? \\\"no\\\" : `${Math.round(a.successRate * 100)}%`;\\n      const sev = report.findings.filter((f) => f.intentId === intent.id).map((f) => f.severity);\\n      const worst = sev.includes(\\\"high\\\") ? \\\"high\\\" : sev.includes(\\\"medium\\\") ? \\\"medium\\\" : sev.includes(\\\"low\\\") ? \\\"low\\\" : \\\"—\\\";\\n      lines.push(`| ${intent.goal} | ${steps} | ${vis(b)} → ${vis(c)} | ${possible(b)} → ${possible(c)} | ${worst} |`);\\n    }\\n    lines.push(\\\"\\\");\\n    for (const f of report.findings) {\\n      lines.push(`- **[${f.severity}]** ${f.title}: ${fmt(f.baseline)} → ${fmt(f.candidate)}`);\\n    }\\n    if (report.findings.length > 0) lines.push(\\\"\\\");\\n    const asym = report.asymmetry.filter((a) => a.baseline !== undefined || a.candidate !== undefined);\\n    const ratio = (v: number | undefined) => (v === undefined ? \\\"n/a\\\" : `${v.toFixed(1)}x`);\\n    for (const a of asym) {\\n      lines.push(\\n        `- Asymmetry (${a.accept} vs ${a.reject}): ${ratio(a.baseline)} → ${ratio(a.candidate)} cost of saying no vs saying yes`,\\n      );\\n    }\\n    if (asym.length > 0) lines.push(\\\"\\\");\\n  }\\n  if (values[\\\"report-url\\\"]) {\\n    lines.push(`Full traces and screenshots: [workflow run artifact](${values[\\\"report-url\\\"]}).`);\\n    lines.push(\\\"\\\");\\n  }\\n  if (values.driver === \\\"scripted\\\") {\\n    lines.push(\\\"_Scripted check: the candidate replays the baseline's recorded path. A broken path means a control moved or disappeared; add the `agencydiff:muse` label to have Muse probes search for the new path and measure its cost._\\\");\\n  }\\n  lines.push(\\\"_Numbers come from recorded probe traces checked against final app state, never from a model's claim._\\\");\\n=====\\n/**\\n * Model judgement for Audit mode. The model sees only the final screenshot\\n * and says whether the Intent looks fulfilled. Results are always labelled\\n * modelJudged and are never evidence in a two-Variant Diff.\\n */\\nexport async function judgeScreenshot(opts: {\\n  apiKey: string;\\n  model?: string;\\n  baseUrl?: string;\\n  goal: string;\\n  png: Buffer;\\n}): Promise<boolean> {\\n  const res = await fetch(`${opts.baseUrl ?? \\\"https://api.meta.ai/v1\\\"}/responses`, {\\n    method: \\\"POST\\\",\\n    headers: { \\\"content-type\\\": \\\"application/json\\\", authorization: `Bearer ${opts.apiKey}` },\\n    body: JSON.stringify({\\n      model: opts.model ?? \\\"muse-spark-1.3\\\",\\n      input: [\\n        {\\n          role: \\\"user\\\",\\n          content: [\\n            {\\n              type: \\\"input_text\\\",\\n              text: `A person using a web app had this intention: \\\"${opts.goal}\\\". Does the attached screenshot of the app's final state show that intention fulfilled? Reply with exactly PASS or FAIL and nothing else.`,\\n            },\\n            { type: \\\"input_image\\\", image_url: `data:image/png;base64,${opts.png.toString(\\\"base64\\\")}` },\\n          ],\\n        },\\n      ],\\n    }),\\n  });\\n  if (!res.ok) throw new Error(`Muse judge ${res.status}: ${await res.text()}`);\\n  const body = (await res.json()) as { output?: { content?: { text?: string }[] }[] };\\n  const text =\\n    body.output?.flatMap((o) => o.content ?? []).map((c) => c.text ?? \\\"\\\").join(\\\"\\\\n\\\") ?? \\\"\\\";\\n  if (/\\\\bPASS\\\\b/i.test(text)) return true;\\n  if (/\\\\bFAIL\\\\b/i.test(text)) return false;\\n  throw new Error(`Unparseable judge verdict: ${JSON.stringify(text.slice(0, 200))}`);\\n}\\n=====\\nimport { countActions, type AgencyReport, type Trace } from \\\"@agencydiff/core\\\";\\n\\n/** Contributor pricing in USD per million tokens. */\\nexport const PRICE_PER_MTOK_IN = 0.1;\\nexport const PRICE_PER_MTOK_OUT = 0.2;\\n\\nexport function usdForTokens(inputTokens: number, outputTokens: number): number {\\n  return (inputTokens * PRICE_PER_MTOK_IN + outputTokens * PRICE_PER_MTOK_OUT) / 1e6;\\n}\\n\\nexport interface GroundTruthEntry {\\n  seed: string;\\n  intents: string[];\\n  direction: \\\"regression\\\" | \\\"none\\\";\\n  metric: string;\\n}\\n\\nexport type HitVia = \\\"finding\\\" | \\\"default\\\" | \\\"behavior\\\" | \\\"judge\\\" | \\\"none\\\";\\n\\nexport interface ExpectedHit {\\n  intent: string;\\n  metric: string;\\n  hit: boolean;\\n  via: HitVia;\\n}\\n\\nexport interface SeedVerdict {\\n  seed: string;\\n  kind: \\\"regression\\\" | \\\"control\\\";\\n  contracts: string[];\\n  detected: boolean;\\n  falseAlarm: boolean;\\n  expected: ExpectedHit[];\\n  missed: string[];\\n  unexpected: { intentId?: string; kind: string; title: string }[];\\n  oraclePassRate: Record<string, { baseline: number; candidate: number }>;\\n}\\n\\n/** True when the candidate traces for an intent differ observably from the\\n *  baseline ones: oracle outcome, final screen, final app state, or effort.\\n *  Catches regressions a same-cost replay cannot, e.g. an intent whose\\n *  oracle is already satisfied but which now strands the user in a dialog. */\\nexport function tracesDiffer(baseline: Trace[], candidate: Trace[]): boolean {\\n  if (baseline.length === 0 || candidate.length === 0) return false;\\n  const sig = (t: Trace) =>\\n    JSON.stringify({\\n      oracle: t.oracle.passed,\\n      screen: t.steps.length ? t.steps[t.steps.length - 1].after.screen : t.initial.observation.screen,\\n      state: t.final.state,\\n      actions: countActions(t),\\n      error: t.error ?? null,\\n    });\\n  const b = new Set(baseline.map(sig));\\n  return candidate.some((t) => !b.has(sig(t)));\\n}\\n\\n/** Population variance of action counts across repeats. */\\nexport function actionVariance(traces: Trace[]): number {\\n  if (traces.length === 0) return 0;\\n  const xs = traces.map(countActions);\\n  const mean = xs.reduce((a, b) => a + b, 0) / xs.length;\\n  return xs.reduce((a, x) => a + (x - mean) ** 2, 0) / xs.length;\\n}\\n\\nexport function oracleRate(traces: Trace[]): number {\\n  if (traces.length === 0) return 0;\\n  return traces.filter((t) => t.oracle.passed === true).length / traces.length;\\n}\\n\\n/**\\n * Score one seed against ground truth. A regression seed is detected when\\n * every expected intent is hit: by a Finding that names it, by a\\n * decision-level default finding when the seed is about the default, or by\\n * an observable trace difference. Findings on other intents are recorded as\\n * unexpected but do not fail the seed; the control false-alarm rate is\\n * measured on the UI_* seeds only.\\n */\\nexport function scoreSeed(opts: {\\n  seed: string;\\n  truth: GroundTruthEntry;\\n  contracts: string[];\\n  reports: AgencyReport[];\\n  tracesByIntent: Map<string, { baseline: Trace[]; candidate: Trace[] }>;\\n}): SeedVerdict {\\n  const { seed, truth, contracts, reports, tracesByIntent } = opts;\\n  const findings = reports.flatMap((r) => r.findings);\\n  const expected: ExpectedHit[] = truth.intents.map((intent) => {\\n    if (findings.some((f) => f.intentId !== undefined && sameIntent(f.intentId, f.decision, intent))) {\\n      return { intent, metric: truth.metric, hit: true, via: \\\"finding\\\" as const };\\n    }\\n    if (\\n      truth.metric === \\\"default\\\" &&\\n      findings.some(\\n        (f) =>\\n          f.kind === \\\"default_flip\\\" &&\\n          truth.intents.some((i) => i === f.decision || i.startsWith(`${f.decision}.`)),\\n      )\\n    ) {\\n      return { intent, metric: truth.metric, hit: true, via: \\\"default\\\" as const };\\n    }\\n    const pair = tracesByIntent.get(qualify(intent, contracts[0]));\\n    if (pair && tracesDiffer(pair.baseline, pair.candidate)) {\\n      return { intent, metric: truth.metric, hit: true, via: \\\"behavior\\\" as const };\\n    }\\n    return { intent, metric: truth.metric, hit: false, via: \\\"none\\\" as const };\\n  });\\n  const missed = expected.filter((e) => !e.hit).map((e) => e.intent);\\n  const expectedSet = new Set(truth.intents.map((i) => qualify(i, contracts[0])));\\n  const unexpected = findings\\n    .filter((f) => f.intentId !== undefined && !expectedSet.has(qualify(f.intentId, f.decision)))\\n    .map((f) => ({ intentId: f.intentId, kind: f.kind, title: f.title }));\\n\\n  const oraclePassRate: Record<string, { baseline: number; candidate: number }> = {};\\n  for (const [key, pair] of tracesByIntent) {\\n    oraclePassRate[key] = { baseline: oracleRate(pair.baseline), candidate: oracleRate(pair.candidate) };\\n  }\\n\\n  const isControl = truth.direction === \\\"none\\\";\\n  const detected = !isControl && missed.length === 0;\\n  const falseAlarm = isControl\\n\",\n  \"original_output_bytes\": 13526,\n  \"original_output_tokens\": 3382,\n  \"truncated\": false\n}","final_result":true}}}
