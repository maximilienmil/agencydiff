{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c401","stream":{"kind":"session","id":"01a19ada-c630-7593-9a67-7c123ee4b98a"},"sequence":91,"recorded_at":1780531400000177,"record_type":"event","durability":"durable","causation_id":"01a19ada-cb11-7393-b695-bdfed4524865","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19ada-cb11-7393-b695-bdfed4524865","run_stream":{"kind":"run","id":"01a19ada-cb11-7393-b695-bdfed4524865"},"task_stream":{"kind":"task","id":"01a19adb-0b92-7960-aaf0-10d4bbf3084d"},"task_id":"01a19adb-0b92-7960-aaf0-10d4bbf3084d","event":{"kind":"output","task_id":"01a19adb-0b92-7960-aaf0-10d4bbf3084d","chunk":"Read text file `apps/circle/src/seeds.ts`.\n1|// Every deliberate agency regression in Circle is a named seed. Baseline runs\n2|// with no seeds, candidate with all of them, and the benchmark can switch each\n3|// one on in isolation (?seeds=DM_HIDE_BLOCK) to measure per-seed recall.\n4|// Ground truth for each seed lives in eval/ground_truth.json.\n5|//\n6|// Seeds prefixed LOC/DM/ST/SUB change the cost, visibility, default or success\n7|// of an intent. Seeds prefixed UI are no-change controls: cosmetic tweaks that\n8|// must not move any intent's numbers, so we can measure false alarms.\n9|\n10|export const SEEDS = {\n11|  /** Prompt offers \"Continue\" + \"More options\"; declining lives one screen deeper. */\n12|  LOC_HIDE_DECLINE: \"Decline hidden behind More options\",\n13|  /** Precise location starts on before the user has chosen anything. */\n14|  LOC_DEFAULT_ON: \"Precise location on by default\",\n15|  /** Turning precise location off asks for confirmation with loss framing. */\n16|  LOC_CONFIRM_SHAME: \"Confirm-shaming dialog on turning location off\",\n17|  /** Location settings move from Settings to Settings > Privacy > Advanced. */\n18|  LOC_BURY_SETTING: \"Location setting buried under Privacy > Advanced\",\n19|  /** Location settings offer an options screen instead of a direct toggle. */\n20|  LOC_NO_DIRECT_TOGGLE: \"Direct location toggle replaced by options screen\",\n21|  /** \"Block unknown people\" hides behind More options on the messages screen. */\n22|  DM_HIDE_BLOCK: \"Block-unknown option hidden behind More options\",\n23|  /** Messaging a teen defaults to open to everyone instead of friends only. */\n24|  DM_DEFAULT_EVERYONE: \"Message audience defaults to everyone\",\n25|  /** Messages move from Privacy to Privacy > Advanced. */\n26|  DM_BURY_MESSAGES: \"Message setting buried under Privacy > Advanced\",\n27|  /** Choosing to block unknown people asks for confirmation with loss framing. */\n28|  DM_CONFIRM_BLOCK: \"Confirm-shaming dialog on blocking unknown messages\",\n29|  /** What each audience option means appears only after choosing, not before. */\n30|  DM_INFO_AFTER_CHOICE: \"Audience explanations shown after commitment\",\n31|  /** Removing a screen-time limit hides behind More options on the limit screen. */\n32|  ST_HIDE_REMOVE: \"Remove-limit hidden behind More options\",\n33|  /** The 1-hour preset disappears; the smallest limit on offer is 2 hours. */\n34|  ST_MIN_LIMIT_2H: \"Smallest daily limit raised to 2 hours\",\n35|  /** Daily limit moves from Screen Time to Screen Time > More settings. */\n36|  ST_BURY_LIMIT: \"Daily limit buried under More settings\",\n37|  /** Setting a daily limit asks for confirmation with loss framing. */\n38|  ST_CONFIRM_LIMIT: \"Confirm-shaming dialog on setting a daily limit\",\n39|  /** Limit presets only select; a separate Save commits the choice. */\n40|  ST_REQUIRE_SAVE: \"Limit choice needs an extra Save tap\",\n41|  /** Declining Circle+ hides behind More options on the offer screen. */\n42|  SUB_HIDE_DECLINE: \"Decline hidden behind More options\",\n43|  /** Cancelling moves from Billing to Billing > Manage plan > Other options. */\n44|  SUB_BURY_CANCEL: \"Cancel buried under Billing > Manage plan > Other\",\n45|  /** The offer preselects the annual plan instead of monthly. */\n46|  SUB_DEFAULT_ANNUAL: \"Circle+ plan defaults to annual\",\n47|  /** Cancelling routes through a retention offer that must be dismissed. */\n48|  SUB_RETENTION_OFFER: \"Retention offer shown before cancelling\",\n49|  /** Price and renewal terms appear only after subscribing, not before. */\n50|  SUB_TERMS_AFTER_CHECKOUT: \"Renewal terms shown after commitment\",\n51|  /** Control: reworded headings and buttons, same layout and tags. */\n52|  UI_COPY_TWEAK: \"Control: copy tweak\",\n53|  /** Control: teal accent instead of blue. */\n54|  UI_ACCENT: \"Control: accent colour\",\n55|  /** Control: settings rows in a different order, same screens and taps. */\n56|  UI_REORDER_SETTINGS: \"Control: settings order\",\n57|  /** Control: feed posts in reverse order. */\n58|  UI_FEED_SHUFFLE: \"Control: feed order\",\n59|  /** Control: reworded privacy rows, same destinations. */\n60|  UI_PRIVACY_COPY: \"Control: privacy copy\",\n61|  /** Control: an extra Appearance row that leads nowhere agency-relevant. */\n62|  UI_EXTRA_ROW: \"Control: extra settings row\",\n63|} as const;\n64|\n65|export type SeedId = keyof typeof SEEDS;\n66|\n67|/** Seeds baked into the build with e.g. `VITE_SEEDS=SUB_HIDE_DECLINE vite build`,\n68| *  so a real pull request can carry a real regression without query flags. */\n69|function bakedSeeds(): Set<SeedId> {\n70|  const raw = import.meta.env?.VITE_SEEDS;\n71|  if (typeof raw !== \"string\" || raw.trim() === \"\") return new Set();\n72|  return new Set(raw.split(\",\").filter((s): s is SeedId => s in SEEDS));\n73|}\n74|\n75|export function activeSeeds(params: URLSearchParams): Set<SeedId> {\n76|  const explicit = params.get(\"seeds\");\n77|  if (explicit !== null) {\n78|    return new Set(explicit.split(\",\").filter((s): s is SeedId => s in SEEDS));\n79|  }\n80|  const seeds =\n81|    params.get(\"variant\") === \"candidate\" ? new Set(Object.keys(SEEDS) as SeedId[]) : new Set<SeedId>();\n82|  for (const s of bakedSeeds()) seeds.add(s);\n83|  return seeds;\n84|}","final_result":true}}}
