618|              <Row label=\"Manage plan\" tag=\"sub.billing_manage\" onClick={() => push(\"plan_manage\")} />\n619|            ) : (\n620|              <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n621|            )}\n622|          </List>\n623|        )}\n624|\n625|        {screen === \"plan_manage\" && (\n626|          <List>\n627|            <Row label=\"Change plan\" />\n628|            <Row label=\"Pause plan\" />\n629|            <Row label=\"Other options\" tag=\"sub.other\" onClick={() => push(\"cancel_other\")} />\n630|          </List>\n631|        )}\n632|\n633|        {screen === \"cancel_other\" && (\n634|          <List>\n635|            <Row label=\"Cancel subscription\" tag=\"sub.cancel\" onClick={requestCancel} />\n636|          </List>\n637|        )}\n638|\n639|        {screen === \"appearance\" && (\n640|          <List>\n641|            <Option\n642|              title=\"Light\"\n643|              sub=\"Default bright theme\"\n644|              tag=\"appearance.light\"\n645|              selected={!dark}\n646|              onPick={() => setDark(false)}\n647|            />\n648|            <Option\n649|              title=\"Dark\"\n650|              sub=\"Dim the interface in the evening\"\n651|              tag=\"appearance.dark\"\n652|              selected={dark}\n653|              onPick={() => setDark(true)}\n654|            />\n655|          </List>\n656|        )}\n657|      </main>\n658|\n659|      {showPrompt && !confirm && (\n660|        <div className=\"scrim\">\n661|          <div className=\"sheet\" role=\"dialog\">\n662|            {has(\"LOC_HIDE_DECLINE\") ? (\n663|              <>\n664|                <div className=\"pin\">📍</div>\n665|                <h2>Find friends and events near you</h2>\n666|                <p>Circle works best with your precise location.</p>\n667|                <button className=\"primary\" data-agency=\"location.allow\" onClick={() => choose(\"precise\")}>\n668|   