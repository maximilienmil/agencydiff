tions: \"Message options\",\n47|  screentime: \"Screen Time\",\n48|  st_more: \"More settings\",\n49|  st_limit: \"Daily limit\",\n50|  st_remove: \"Remove limit\",\n51|  usage: \"Your time\",\n52|  plus: \"Circle+\",\n53|  decline_options: \"More options\",\n54|  terms: \"Renewal terms\",\n55|  billing: \"Billing\",\n56|  plan_manage: \"Manage plan\",\n57|  cancel_other: \"Other options\",\n58|  appearance: \"Appearance\",\n59|};\n60|\n61|function initialLocation(params: URLSearchParams): LocationState {\n62|  if (params.get(\"fixture\") === \"location-shared\") return { mode: \"precise\", prompt: \"answered\" };\n63|  // Any other fixture means the probe starts past onboarding: the location\n64|  // prompt is answered and out of the way of the decision under test.\n65|  if (params.get(\"fixture\")) return { mode: \"off\", prompt: \"answered\" };\n66|  return { mode: \"off\", prompt: \"open\" };\n67|}\n68|\n69|function initialDm(params: URLSearchParams): DmState {\n70|  if (params.get(\"fixture\") === \"dm-restricted\") return { policy: \"blocked\" };\n71|  return { policy: \"friends\" };\n72|}\n73|\n74|function initialSt(params: URLSearchParams): StState {\n75|  if (params.get(\"fixture\") === \"limit-set\") return { limit: 480, reminders: false };\n76|  return { limit: null, reminders: false };\n77|}\n78|\n79|function initialSub(params: URLSearchParams): SubState {\n80|  const fixture = params.get(\"fixture\");\n81|  if (fixture === \"subscribed\") return { active: true, plan: \"monthly\", offer: \"answered\" };\n82|  if (fixture === \"cancelled\") return { active: false, plan: \"monthly\", offer: \"answered\" };\n83|  return { active: false, plan: \"monthly\", offer: \"open\" };\n84|}\n85|\n86|declare global {\n87|  interface Window {\n88|    __circle?: { state: () => Record<string, unknown> };\n89|  }\n90|}\n91|\n92|const AUDIENCE_INFO: Record<DmPolicy, string> = {\n93|  everyone: \"Anyone on Circle will be able to send messages to this account, including people you don't know.\",\n94|  friends: \"Only people you follow back will be able to message this account.\",\n95|  blocked: \"People you don't know will be blocked from messaging this account.\",\n96|};\n97|\n98|function limitLabel(limit: number | null): string {\n99|  if (limit === null) return \"Off\";\n100|  const h = limit / 60;\n101|  return `${h} hour${h === 1 ? \"\" : \"s\"} a day`;\n102|}\n103|\n104|const PLAN_NAME: Record<SubPlan, string> = { monthly: \"Monthly\", annual: \"Annual\" };\n105|const PLAN_PRICE: Record<SubPlan, string> = { monthly: \"$4.99/mo\", annual: \"$47.99/yr\" };\n106|\n107|export function App() {\n108|  const params = useMemo(() => new URLSearchParams(location.search), []);\n109|  const has = (_s: string) => false;\n110|\n111|  const [loc, setLoc] = useState<LocationState>(() => initialLocation(params));\n112|  const [dm, setDm] = useState<DmState>(() => initialDm(params));\n113|  const [st, setSt] = useState<StState>(() => initialSt(params));\n114|  const [sub, setSub] = useState<SubState>(() => initialSub(params));\n115|  const [stack, setStack] = useState<Screen[]>([\"home\"]);\n116|  const [seen, setSeen] = useState<string[]>([]);\n117|  const [confirm, setConfirm] = useState<null | (() => void)>(null);\n118|  const [dmConfirm, setDmConfirm] = useState<null | (() => void)>(null);\n119|  const [dmPending, setDmPending] = useState<DmPolicy | null>(null);\n120|  const [stPending, setStPending] = useState<{ value: number | null } | null>(null);\n121|  const [stConfirm, setStConfirm] = useState<null | (() => void)>(null);\n122|  const [subRetain, setSubRetain] = useState(false);\n123|  const [dark, setDark] = useState(false);\n124|  // Optional sign-in gate: behind ?auth=1 the app shows a\n125|  // sign-in screen until the test user is authenticated. The session\n126|  // persists in localStorage so a saved storageState file carries it.\n127|  const needsAuth = params.get(\"auth\") === \"1\";\n128|  const [authed, setAuthed] = useState(() => !needsAuth || localStorage.getItem(\"circle.auth\") === \"1\");\n129|  const [loginUser, setLoginUser] = useState(\"\");\n130|  const [loginPass, setLoginPass] = useState(\"\");\n131|  const [loginError, setLoginError] = useState<string | null>(null);\n132|  const screen = stack[stack.length - 1];\n133|\n134|  const signIn = () => {\n135|    // Demo gate only, not a real credential check: the documented test\n136|    // user signs in with any non-empty password; anything else is refused.\n137|    if (loginUser === \"test-user\" && loginPass.length > 0) {\n138|      localStorage.setItem(\"circle.auth\", \"1\");\n139|      setAuthed(true);\n140|    } else {\n141|      setLoginError(\"Use the test account test-user with any password.\");\n142|    }\n143|  };\n144|\n145|  useEffect(() => {\n146|    window.__circle = {\n147|      state: () => ({\n148|        \"auth.signedIn\": needsAuth ? authed : true,\n149|        \"location.precise\": loc.mode === \"precise\",\n150|        \"location.mode\": loc.mode,\n151|        \"location.prompt\": loc.prompt,\n152|        \"dm.policy\": dm.policy,\n153|        \"dm.inspected\": seen.includes(\"messages\") || seen.includes(\"dm_options\"),\n154|        \"st.limit\": st.limit,\n155|        \"st.reminders\": st.reminders,\n156|        \"st.viewed\": seen.includes(\"usage\"),\n157|        \"sub.active\": sub.active,\n158|        \"sub.plan\": sub.plan,\n159|        \"sub.offer\": sub.offer,\n160|        \"sub.terms_viewed\": seen.includes(\"terms\"),\n161|      }),\n162|    };\n163|  }, [loc, dm, st, sub, seen, needsAuth, authed]);\n164|\n165|  const push = (s: Screen) => {\n166|    setStack((stck) => [...stck, s]);\n167|    setSeen((prev) => (prev.includes(s) ? prev : [...prev, s]));\n168|  };\n169|  const pop = () => setStack((stck) => (stck.length > 1 ? stck.slice(0, -1) : stck));\n170|\n171|  /** Apply a location choice. */\n172|  const choose = (mode: Mode, after?: () => void) => {\n173|    const commit = () => {\n174|      setLoc({ mode, prompt: \"answered\" });\n175|      setConfirm(null);\n176|      after?.();\n177|    };\n178|    if (mode !== \"precise\" && loc.mode === \"precise\" && false) {\n179|      setConfirm(() => commit);\n180|    } else {\n181|      commit();\n182|    }\n183|  };\n184|\n185|  const commitDm = (policy: DmPolicy) => {\n186|    setDm({ policy });\n187|    setDmConfirm(null);\n188|    setDmPending(null);\n189|  };\n190|\n191|  /** Apply a message-audience choice. */\n192|  const chooseDm = (policy: DmPolicy) => {\n193|    const viaInfo = () => {\n194|      if (false) setDmPending(policy);\n195|      else commitDm(policy);\n196|    };\n197|    if (policy === \"blocked\" && dm.policy !== \"blocked\" && false) {\n198|      setDmConfirm(() => viaInfo);\n199|    } else {\n200|      viaInfo();\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
