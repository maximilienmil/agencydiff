ring;\n823|  sub: string;\n824|  tag: string;\n825|  selected: boolean;\n826|  onPick: () => void;\n827|}) {\n828|  return (\n829|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n830|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n831|      <span>\n832|        {title}\n833|        <small>{sub}</small>\n834|      </span>\n835|    </button>\n836|  );\n837|}\n838|\n839|const POSTS = [\n840|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n841|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n842|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n843|];\n844|\n845|function Feed({ posts }: { posts: typeof POSTS }) {\n846|  return (\n847|    <div className=\"feed\">\n848|      {posts.map((p) => (\n849|        <article key={p.who} className=\"post\">\n850|          <div className=\"who\">\n851|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n852|            {p.who}\n853|          </div>\n854|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n855|          <p>{p.text}</p>\n856|        </article>\n857|      ))}\n858|    </div>\n859|  );\n860|}\n861|","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
