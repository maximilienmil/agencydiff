Keep Circle+\n764|            </button>\n765|            <button className=\"link\" data-agency=\"sub.confirm_cancel\" onClick={confirmCancel}>\n766|              Cancel anyway\n767|            </button>\n768|          </div>\n769|        </div>\n770|      )}\n771|    </div>\n772|  );\n773|}\n774|\n775|function LocationOptions({ current, onSave }: { current: Mode; onSave: (m: Mode) => void }) {\n776|  const [mode, setMode] = useState<Mode>(current === \"off\" ? \"precise\" : current);\n777|  const opt = (m: Mode, label: string, tag: string) => (\n778|    <label className=\"row radio-row\">\n779|      <input type=\"radio\" name=\"loc\" data-agency={tag} checked={mode === m} onChange={() => setMode(m)} />\n780|      <span>{label}</span>\n781|    </label>\n782|  );\n783|  return (\n784|    <>\n785|      <List>\n786|        {opt(\"precise\", \"Precise location (recommended)\", \"location.opt_precise\")}\n787|        {opt(\"approximate\", \"Approximate location\", \"location.opt_approximate\")}\n788|        {opt(\"off\", \"Don't use my location\", \"location.decline\")}\n789|      </List>\n790|      <div className=\"footer\">\n791|        <button className=\"primary\" data-agency=\"location.save\" onClick={() => onSave(mode)}>\n792|          Save\n793|        </button>\n794|      </div>\n795|    </>\n796|  );\n797|}\n798|\n799|function List({ children }: { children: React.ReactNode }) {\n800|  return <div className=\"list\">{children}</div>;\n801|}\n802|\n803|function Row({ label, detail, tag, onClick }: { label: string; detail?: string; tag?: string; onClick?: () => void }) {\n804|  return (\n805|    <button className=\"row\" data-agency={tag} onClick={onClick}>\n806|      <span>\n807|        {label}\n808|        {detail && <small>{detail}</small>}\n809|      </span>\n810|      <span className=\"chev\">›</span>\n811|    </button>\n812|  );\n813|}\n814|\n815|function Option({\n816|  title,\n817|  sub,\n818|  tag,\n819|  selected,\n820|  onPick,\n821|}: {\n822|  title: string;\n823|  sub: string;\n824|  tag: string;\n825|  selected: boolean;\n826|  onPick: () => void;\n827|}) {\n828|  return (\n829|    <button className=\"row radio-row\" data-agency={tag} onClick={onPick}>\n830|      <span className={selected ? \"dot on\" : \"dot\"} aria-hidden />\n831|      <span>\n832|        {title}\n833|        <small>{sub}</small>\n834|      </span>\n835|    </button>\n836|  );\n837|}\n838|\n839|const POSTS = [\n840|  { who: \"maya.r\", hue: 12, text: \"first day of the rooftop garden 🌱\" },\n841|  { who: \"dev_ko\", hue: 210, text: \"new skate spot by the river\" },\n842|  { who: \"lina\", hue: 280, text: \"study group tonight?\" },\n843|];\n844|\n845|function Feed({ posts }: { posts: typeof POSTS }) {\n846|  return (\n847|    <div className=\"feed\">\n848|      {posts.map((p) => (\n849|        <article key={p.who} className=\"post\">\n850|          <div className=\"who\">\n851|            <span className=\"avatar\" style={{ background: `hsl(${p.hue} 70% 60%)` }} />\n852|            {p.who}\n853|          </div>\n854|          <div className=\"photo\" style={{ background: `linear-gradient(135deg, hsl(${p.hue} 70% 75%), hsl(${p.hue + 40} 60% 55%))` }} />\n855|          <p>{p.text}</p>\n856|        </article>\n857|      ))}\n858|    </div>\n859|  );\n860|}\n861|","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
