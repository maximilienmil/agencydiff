 50%; border: 2px solid var(--ds-line-strong);\n150|  background: var(--card); cursor: pointer; transition: all var(--ds-fast) var(--ds-ease);\n151|}\n152|input[type=\"radio\"]:checked { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 4px var(--card); }\n153|.footer { padding: 20px 18px; }\n154|\n155|/* Sheets */\n156|.scrim {\n157|  position: fixed; inset: 0; z-index: 10; background: rgba(11, 15, 20, 0.5);\n158|  display: flex; align-items: flex-end; justify-content: center;\n159|  animation: circle-fade var(--ds-med) var(--ds-ease) both;\n160|}\n161|.sheet {\n162|  width: 100%; max-width: 430px; background: var(--card); border-radius: 24px 24px 0 0;\n163|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n164|  position: relative; box-shadow: var(--ds-shadow-3);\n165|  animation: circle-rise 240ms var(--ds-ease) both;\n166|}\n167|.scrim .sheet::before {\n168|  content: \"\"; position: absolute; top: 8px; left: 50%; width: 36px; height: 4px; margin-left: -18px;\n169|  border-radius: 999px; background: var(--ds-line-strong);\n170|}\n171|.sheet h2 { margin: 4px 0 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }\n172|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n173|.pin { height: 41px; display: grid; place-items: center; }\n174|.pin .ic {\n175|  width: 41px; height: 41px; padding: 8px; border-radius: 50%;\n176|  background: var(--ds-blue-wash); color: var(--accent);\n177|}\n178|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n179|\n180|.primary, .secondary {\n181|  height: 48px; border-radius: 999px; font-weight: 650; font-size: 15px; width: 100%;\n182|  transition: background var(--ds-fast) var(--ds-ease), transform var(--ds-fast) var(--ds-ease);\n183|}\n184|.primary { background: var(--accent); color: #fff; }\n185|.primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }\n186|.secondary { background: var(--ds-surface-2); color: var(--ink); }\n187|.secondary:hover { background: var(--ds-surface-3); }\n188|.primary:active, .secondary:active { transform: scale(0.985); }\n189|.link { color: var(--muted); font-size: 13px; padding: 6px; font-weight: 550; }\n190|.link:hover { color: var(--ink); }\n191|\n192|.dot {\n193|  width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ds-line-strong); flex: none;\n194|  transition: all var(--ds-fast) var(--ds-ease);\n195|}\n196|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 4px var(--card); }\n197|\n198|.stat { padding: 18px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; position: relative; }\n199|.stat .big { font-size: 28px; font-weight: 750; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }\n200|.stat small { color: var(--muted); font-size: 13px; }\n201|.week {\n202|  position: absolute; right: 18px; top: 18px; bottom: 18px; width: 92px;\n203|  display: flex; align-items: flex-end; gap: 5px;\n204|}\n205|.week .wk { flex: 1; border-radius: 4px; background: var(--ds-blue-wash); min-height: 4px; }\n206|.week .wk.today { background: var(--accent); }\n207|.note { padding: 14px 18px; color: var(--ds-ink-2); font-size: 14px; line-height: 1.45; border-bottom: 1px solid var(--line); }\n208|\n209|/* Circle+ offer header */\n210|.app[data-screen^=\"plus\"] .stat .big {\n211|  color: var(--accent);\n212|}\n213|\n214|/* Sign-in */\n215|.login { display: flex; flex-direction: column; gap: 12px; border-radius: 0; box-shadow: none; text-align: left; }\n216|.login h2 { font-size: 24px; }\n217|.field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }\n218|.field input {\n219|  height: 48px; border: 1px solid var(--ds-line-strong); border-radius: 12px;\n220|  padding: 0 14px; font: inherit; font-weight: 400; background: var(--card); color: var(--ink);\n221|  transition: 