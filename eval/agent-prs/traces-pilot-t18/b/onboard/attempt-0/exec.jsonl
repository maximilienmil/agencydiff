th: 32px; height: 32px; border-radius: 50%; }\n31|.post .photo { aspect-ratio: 1 / 1; }\n32|.post p { margin: 10px 14px 0; font-size: 14px; }\n33|\n34|.list { display: flex; flex-direction: column; }\n35|.row {\n36|  display: flex; align-items: center; justify-content: space-between; gap: 12px;\n37|  width: 100%; min-height: 56px; padding: 0 18px; text-align: left; font-size: 16px;\n38|  border-bottom: 1px solid var(--line);\n39|}\n40|.row small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; }\n41|.chev { color: var(--muted); font-size: 22px; }\n42|.toggle-row, .radio-row { cursor: pointer; padding: 10px 18px; }\n43|.radio-row { justify-content: flex-start; }\n44|input[type=\"checkbox\"], input[type=\"radio\"] { width: 22px; height: 22px; accent-color: var(--accent); }\n45|.footer { padding: 20px 18px; }\n46|\n47|.scrim { position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; justify-content: center; }\n48|.sheet {\n49|  width: 100%; max-width: 430px; background: var(--card); border-radius: 18px 18px 0 0;\n50|  padding: 24px 20px 28px; display: flex; flex-direction: column; gap: 10px; text-align: center;\n51|}\n52|.sheet h2 { margin: 4px 0 0; font-size: 20px; }\n53|.sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; line-height: 1.4; }\n54|.pin { font-size: 34px; }\n55|.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n56|\n57|.primary, .secondary { height: 48px; border-radius: 12px; font-weight: 600; font-size: 15px; width: 100%; }\n58|.primary { background: var(--accent); color: #fff; }\n59|.secondary { background: #eef1f6; }\n60|.link { color: var(--muted); font-size: 13px; padding: 6px; }\n61|\n62|.dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); flex: none; }\n63|.dot.on { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 3px var(--card); }\n64|.stat { padding: 18px; border-bottom: 1p