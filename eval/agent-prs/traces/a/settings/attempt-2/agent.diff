+
+function SettingsList({
+  query,
+  onQuery,
+  onPrivacy,
+  onLocation,
+  onScreenTime,
+  onPlus,
+}: {
+  query: string;
+  onQuery: (q: string) => void;
+  onPrivacy: () => void;
+  onLocation: () => void;
+  onScreenTime: () => void;
+  onPlus: () => void;
+}) {
+  const q = query.trim().toLowerCase();
+  const match = (label: string) => !q || label.toLowerCase().includes(q);
+  const mostUsed = [
+    { label: "Privacy", tag: "settings.privacy", onClick: onPrivacy },
+    { label: "Screen Time", tag: "settings.screentime", onClick: onScreenTime },
+    { label: "Notifications", tag: undefined as string | undefined, onClick: undefined as (() => void) | undefined },
+  ].filter((r) => match(r.label));
+  const more = [
+    { label: "Account", tag: undefined as string | undefined, onClick: undefined as (() => void) | undefined },
+    { label: "Location", tag: "settings.location", onClick: onLocation },
+    { label: "Circle+", tag: "settings.subscription", onClick: onPlus },
+    { label: "Help", tag: undefined as string | undefined, onClick: undefined as (() => void) | undefined },
+  ].filter((r) => match(r.label));
+  return (
+    <List>
+      <div className="settings-search">
+        <input
+          type="search"
+          placeholder="Search settings"
+          aria-label="Search settings"
+          data-agency="settings.search"
+          value={query}
+          onChange={(e) => onQuery(e.target.value)}
+        />
+      </div>
+      {mostUsed.length > 0 && (
+        <>
+          <div className="section-label" aria-hidden={!q}>
+            Most used
+          </div>
+          {mostUsed.map((r) => (
+            <Row key={r.label} label={r.label} tag={r.tag} onClick={r.onClick} />
+          ))}
+        </>
+      )}
+      {more.length > 0 && (
+        <>
+          <div className="section-label" aria-hidden={!q}>
+            More
+          </div>
+          {more.map((r) => (
+            <Row key={r.label} label={r.label} tag={r.tag} onClick={r.onClick} />
+          ))}
+        </>
+      )}
+      {mostUsed.length === 0 && more.length === 0 && (
+        <div className="note">No settings match “{query.trim()}”.</div>
+      )}
+    </List>
+  );
 }
 
